<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Number System Hub</title>
    <!-- Textbook Quality Typography Embedding -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Montserrat:wght@400;600;800&family=Open+Sans:wght@400;600&family=Roboto+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #121214;       /* Pure Obsidian Canvas */
            --bg-surface: #1E1A2A;       /* Muted Deep Purple Cards */
            --accent-dark: #A5B4FC;      /* Pale Lavender Blue Tones */
            --accent-muted: #5650A6;     /* Deep Royal Secondary */
            --accent-fresh: #241D52;     /* Dark Velvet Tint */
            --text-main: #EAEAEA;        /* Soft Off-White Core Typography */
            --text-muted: #A3A3C2;       /* Relaxed Slate Annotation */
            --text-light: #121214;       /* Heavy Core Overlays */
            --gray-disabled: #181522;    /* Recessed Inactive Key Mask */
            --border: #3A355C;           /* High-Definition Divider Linework */
            --correct: #81C784;          /* Soft Emerald Glowing Status */
            --incorrect: #FF8A80;        /* Soft Crimson Fault Marker */
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            font-family: 'Open Sans', sans-serif;
            padding: 24px;
            line-height: 1.6;
        }

        .container {
            width: 100%;
            max-width: 1050px;
            background-color: var(--bg-surface);
            border-radius: 20px;
            padding: 32px;
            margin: 20px auto;
            box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
            border: 1px solid var(--border);
        }

        header {
            text-align: center;
            margin-bottom: 32px;
            border-bottom: 2px solid var(--border);
            padding-bottom: 20px;
            position: relative;
        }

        header h1 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            color: var(--accent-dark);
            font-size: 32px;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        header p {
            color: var(--text-muted);
            font-size: 15px;
        }
        .manual-trigger-btn {
            position: absolute;
            right: 0;
            top: 10px;
            background-color: var(--accent-dark);
            color: var(--text-light);
            border: none;
            padding: 10px 20px;
            border-radius: 24px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            box-shadow: 0 4px 14px rgba(165, 180, 252, 0.3);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .manual-trigger-btn:hover {
            background-color: #C7D2FE;
            transform: translateY(-2px);
        }

        .tabs {
            display: flex;
            gap: 12px;
            margin-bottom: 28px;
        }

        .tab-btn {
            flex: 1;
            padding: 14px;
            background: #151221;
            border: 1px solid var(--border);
            color: var(--text-muted);
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 14px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .tab-btn:hover {
            color: var(--text-main);
            border-color: var(--accent-dark);
        }

        .tab-btn.active {
            background: var(--accent-dark);
            color: var(--text-light);
            border-color: var(--accent-dark);
            box-shadow: 0 4px 16px rgba(165, 180, 252, 0.2);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .calc-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 28px;
            margin-bottom: 24px;
        }

        .display-panel {
            background: var(--bg-primary);
            padding: 20px;
            border-radius: 14px;
            margin-bottom: 20px;
            border: 2px solid var(--border);
        }

        .base-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            border-bottom: 1px solid rgba(58, 53, 92, 0.4);
            gap: 16px;
        }

        .base-row:last-child {
            border-bottom: none;
        }

        .base-row.selected {
            background: rgba(165, 180, 252, 0.06);
            border-radius: 8px;
            border-bottom-color: transparent;
        }

        .base-label {
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 13px;
            color: var(--text-muted);
            width: 50px;
        }

        .base-row.selected .base-label {
            color: var(--accent-dark);
        }
        .value-wrapper {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-grow: 1;
            justify-content: flex-end;
            min-width: 0;
        }

        .base-value {
            font-size: 22px;
            font-family: 'Roboto Mono', monospace;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: var(--text-main);
        }

        .copy-btn {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            color: var(--accent-dark);
            padding: 6px 12px;
            font-family: 'Montserrat', sans-serif;
            font-size: 11px;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .copy-btn:hover {
            background: var(--accent-muted);
            color: var(--text-main);
        }

        .base-selector {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .base-radio {
            flex: 1;
        }

        .base-radio input {
            display: none;
        }

        .base-radio label {
            display: block;
            padding: 14px 6px;
            background: #151221;
            border: 1px solid var(--border);
            border-radius: 8px;
            text-align: center;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 13px;
            color: var(--text-muted);
            transition: all 0.2s;
        }

        .base-radio input:checked + label {
            background: var(--accent-dark);
            color: var(--text-light);
            border-color: var(--accent-dark);
        }

        .keypad {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .key {
            padding: 20px 10px;
            background: #151221;
            border: 1px solid var(--border);
            color: var(--text-main);
            font-family: 'Roboto Mono', monospace;
            font-size: 20px;
            font-weight: 700;
            border-radius: 10px;
            cursor: pointer;
            transition: background 0.15s, transform 0.1s;
        }

        .key:active {
            transform: scale(0.97);
        }

        .key.action-key {
            background: var(--accent-fresh);
            color: var(--accent-dark);
            border-color: var(--accent-muted);
        }

        .key.clear-key {
            background: rgba(255, 138, 128, 0.08);
            color: var(--incorrect);
            border-color: rgba(255, 138, 128, 0.2);
        }

        .key:disabled, .key.grayed-out {
            background: var(--gray-disabled) !important;
            color: #3D3552 !important;
            border-color: #151221 !important;
            opacity: 0.3;
            cursor: not-allowed;
            transform: none !important;
        }
        .explanation-trigger-pane {
            text-align: center;
            margin: 12px 0;
        }

        .popup-toggle-btn {
            background: var(--accent-fresh);
            border: 2px solid var(--accent-dark);
            color: var(--accent-dark);
            padding: 14px 28px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 15px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
        }

        .popup-toggle-btn:hover {
            background: var(--accent-dark);
            color: var(--text-light);
            transform: translateY(-2px);
        }

        .steps-drawer-modal {
            background: #161322;
            padding: 24px;
            border-radius: 16px;
            border: 2px solid var(--accent-dark);
            margin-top: 20px;
            display: none;
            box-shadow: inset 0 4px 20px rgba(0,0,0,0.4);
        }

        .steps-drawer-modal h3 {
            font-family: 'Montserrat', sans-serif;
            font-size: 18px;
            margin-bottom: 20px;
            color: var(--accent-dark);
            border-bottom: 1px solid var(--border);
            padding-bottom: 8px;
        }

        .conversion-block {
            background: var(--bg-primary);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 16px;
            margin-bottom: 20px;
        }

        .conversion-block:last-child {
            margin-bottom: 0;
        }

        .conversion-block h4 {
            font-family: 'Montserrat', sans-serif;
            font-size: 15px;
            color: var(--accent-dark);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .visual-box-container {
            display: flex;
            gap: 6px;
            margin: 12px 0;
            flex-wrap: wrap;
        }

        .visual-box {
            background: var(--accent-fresh);
            border: 1px solid var(--accent-dark);
            color: var(--accent-dark);
            font-family: 'Roboto Mono', monospace;
            font-weight: 700;
            width: 36px;
            height: 36px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 6px;
            font-size: 14px;
        }

        .visual-box.active {
            background: var(--accent-dark);
            color: var(--text-light);
        }

        .step-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            font-size: 13px;
            font-family: 'Roboto Mono', monospace;
        }

        .step-table th, .step-table td {
            border: 1px solid var(--border);
            padding: 10px;
            text-align: left;
        }

        .step-table th {
            background: rgba(165, 180, 252, 0.08);
            color: var(--text-muted);
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
        }

        .quiz-card {
            background: var(--bg-primary);
            padding: 32px;
            border-radius: 16px;
            border: 2px solid var(--border);
            text-align: center;
        }

        .quiz-question {
            font-size: 20px;
            margin-bottom: 20px;
            font-family: 'Open Sans', sans-serif;
        }

        .quiz-input-group {
            display: flex;
            max-width: 440px;
            margin: 0 auto 20px auto;
            gap: 10px;
        }

        .quiz-field {
            flex: 1;
            padding: 14px;
            background: #151221;
            border: 1px solid var(--border);
            color: #fff;
            font-size: 20px;
            font-family: 'Roboto Mono', monospace;
            border-radius: 8px;
            text-transform: uppercase;
            text-align: center;
            outline: none;
        }

        .quiz-field:focus {
            border-color: var(--accent-dark);
        }

        .quiz-submit {
            padding: 14px 28px;
            background: var(--accent-dark);
            border: none;
            color: var(--text-light);
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
        }

        .quiz-controls {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-top: 16px;
            align-items: center;
        }

        .restart-btn {
            background: transparent;
            border: 1px solid var(--incorrect);
            color: var(--incorrect);
            padding: 8px 16px;
            border-radius: 6px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .restart-btn:hover {
            background: rgba(255, 138, 128, 0.1);
        }

        .feedback-banner {
            padding: 14px;
            border-radius: 8px;
            margin-top: 16px;
            font-weight: bold;
            display: none;
            text-align: left;
        }

        .feedback-banner.success {
            display: block;
            background: rgba(129, 199, 132, 0.08);
            color: var(--correct);
            border-left: 4px solid var(--correct);
        }

        .feedback-banner.error {
            display: block;
            background: rgba(255, 138, 128, 0.08);
            color: var(--incorrect);
            border-left: 4px solid var(--incorrect);
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            backdrop-filter: blur(4px);
        }

        .modal-content {
            background: var(--bg-surface);
            border: 2px solid var(--border);
            border-radius: 16px;
            max-width: 600px;
            width: 100%;
            padding: 28px;
            max-height: 85vh;
            overflow-y: auto;
        }

        .modal-content h2 {
            font-family: 'Montserrat', sans-serif;
            color: var(--accent-dark);
            margin-bottom: 16px;
            font-size: 24px;
        }

        .modal-content li {
            margin-left: 20px;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .close-modal-btn {
            background: var(--accent-dark);
            color: var(--text-light);
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            margin-top: 20px;
            cursor: pointer;
            float: right;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Number System Hub</h1>
        <p>Interactive Computer Science Conceptual Workspace</p>
        <button class="manual-trigger-btn" onclick="openManual()">📖 User Manual</button>
    </header>

    <div class="tabs">
        <button id="btn-tab-calc" class="tab-btn active" onclick="switchTab('calc')">Interactive Converter Platform</button>
        <button id="btn-tab-quiz" class="tab-btn" onclick="switchTab('quiz')">Self-Assessment Challenge Lab</button>
    </div>

    <!-- CALC SHEET INTERFACE -->
    <div id="calc-tab" class="tab-content active">
        <div class="calc-layout">
            <div>
                <div class="base-selector">
                    <div class="base-radio">
                        <input type="radio" id="src-bin" name="src-base" value="2" onchange="changeActiveBase('BIN', 2)">
                        <label for="src-bin">BIN (Base 2)</label>
                    </div>
                    <div class="base-radio">
                        <input type="radio" id="src-oct" name="src-base" value="8" onchange="changeActiveBase('OCT', 8)">
                        <label for="src-oct">OCT (Base 8)</label>
                    </div>
                    <div class="base-radio">
                        <input type="radio" id="src-dec" name="src-base" value="10" checked onchange="changeActiveBase('DEC', 10)">
                        <label for="src-dec">DEC (Base 10)</label>
                    </div>
                    <div class="base-radio">
                        <input type="radio" id="src-hex" name="src-base" value="16" onchange="changeActiveBase('HEX', 16)">
                        <label for="src-hex">HEX (Base 16)</label>
                    </div>
                </div>

                <div class="display-panel">
                    <div class="base-row" id="row-BIN"><span class="base-label">BIN</span><div class="value-wrapper"><span class="base-value" id="val-BIN">0</span><button class="copy-btn" onclick="copyValue('val-BIN')">Copy</button></div></div>
                    <div class="base-row" id="row-OCT"><span class="base-label">OCT</span><div class="value-wrapper"><span class="base-value" id="val-OCT">0</span><button class="copy-btn" onclick="copyValue('val-OCT')">Copy</button></div></div>
                    <div class="base-row" id="row-DEC"><span class="base-label">DEC</span><div class="value-wrapper"><span class="base-value" id="val-DEC">0</span><button class="copy-btn" onclick="copyValue('val-DEC')">Copy</button></div></div>
                    <div class="base-row" id="row-HEX"><span class="base-label">HEX</span><div class="value-wrapper"><span class="base-value" id="val-HEX">0</span><button class="copy-btn" onclick="copyValue('val-HEX')">Copy</button></div></div>
                </div>

                <div class="keypad">
                    <button class="key action-key" onclick="pressKey('D')">D</button>
                    <button class="key action-key" onclick="pressKey('E')">E</button>
                    <button class="key action-key" onclick="pressKey('F')">F</button>
                    <button class="key clear-key" onclick="clearCalculator()">AC</button>
                    <button class="key action-key" onclick="pressKey('A')">A</button>
                    <button class="key action-key" onclick="pressKey('B')">B</button>
                    <button class="key action-key" onclick="pressKey('C')">C</button>
                    <button class="key" onclick="pressKey('9')">9</button>
                    <button class="key" onclick="pressKey('8')">8</button>
                    <button class="key" onclick="pressKey('7')">7</button>
                    <button class="key" onclick="pressKey('6')">6</button>
                    <button class="key" onclick="pressKey('5')">5</button>
                    <button class="key" onclick="pressKey('4')">4</button>
                    <button class="key" onclick="pressKey('3')">3</button>
                    <button class="key" onclick="pressKey('2')">2</button>
                    <button class="key" onclick="pressKey('1')">1</button>
                    <button class="key" style="grid-column: span 4;" onclick="pressKey('0')">0</button>
                </div>
            </div>
        </div>

        <div class="explanation-trigger-pane">
            <button class="popup-toggle-btn" id="drawer-toggle-btn" onclick="toggleExplanationDrawer()">👇 Click to Reveal Step-by-Step Explanations Underneath</button>
        </div>

        <!-- COLLAPSIBLE EDUCATIONAL CONTAINER -->
        <div class="steps-drawer-modal" id="explanation-drawer">
            <h3>📖 Deep Conceptual Breakdown Pipeline</h3>
            <div id="steps-output">Enter numbers above to compile visual explanation charts.</div>
        </div>
    </div>
    <!-- QUIZ PRACTICE MODULE -->
    <div id="quiz-tab" class="tab-content">
        <div class="quiz-card">
            <div class="quiz-question" id="quiz-prompt">Generating math problem parameters...</div>
            <div class="quiz-input-group">
                <input type="text" id="quiz-answer" class="quiz-field" placeholder="Answer string..." autocomplete="off">
                <button class="quiz-submit" onclick="submitQuizAnswer()">Submit Answer</button>
            </div>
            <div id="quiz-feedback" class="feedback-banner"></div>
            
            <div class="quiz-controls">
                <div id="quiz-score" style="font-family:'Montserrat',sans-serif; font-weight:600; font-size:15px; color:var(--accent-dark);">Success Register: 0 / 0 (0%)</div>
                <button class="restart-btn" onclick="resetQuizLogMetrics()">🔄 Reset Progress</button>
            </div>
            
            <div id="quiz-explanation-box" class="steps-panel" style="margin-top: 24px; display: none; text-align: left;"></div>
        </div>
    </div>
</div>

<div id="manual-modal" class="modal-overlay" onclick="closeManualOnOverlay(event)">
    <div class="modal-content">
        <h2>📖 System Operator Manual</h2>
        <p style="margin-bottom: 12px; font-size: 14px; color: var(--text-muted);">Welcome to the textbook-grade conceptual number baseline trainer app layout framework.</p>
        <ul>
            <li><b>Reactive Safeguard Keypad:</b> Changing the input configuration radio toggles adapts the physical keypad matrix rules instantly, masking invalid symbols behind dark blocks to eliminate input mistakes entirely.</li>
            <li><b>Collapsible Pipeline:</b> Click the deep-green button at the bottom of the calculator layout page to smoothly expand the structural mathematical translation loops block beneath.</li>
            <li><b>Challenge Lab Tracker:</b> Navigate to the quiz portal to answer questions. An automated tracking sequence logs progress, flags failures with step answers, and maintains a clean success percentage.</li>
        </ul>
        <button class="close-modal-btn" onclick="closeManual()">Close Manual Workspace</button>
    </div>
</div>

<script>
    let activeBaseName = 'DEC';
    let activeRadix = 10;
    let internalDecimalValue = 0;
    let explanationDrawerOpen = false;

    let quizCorrect = 0;
    let quizTotal = 0;
    let activeQuizAnswerKey = "";
    let activeQuizDecimalValue = 0;
    let activeQuizTargetRadix = 10;
    window.onload = function() {
        updateKeypadMasking();
        generateQuizQuestion();
    };

    function switchTab(tabId) {
        document.getElementById('calc-tab').classList.remove('active');
        document.getElementById('quiz-tab').classList.remove('active');
        document.getElementById('btn-tab-calc').classList.remove('active');
        document.getElementById('btn-tab-quiz').classList.remove('active');
        
        if(tabId === 'calc') {
            document.getElementById('calc-tab').classList.add('active');
            document.getElementById('btn-tab-calc').classList.add('active');
        } else {
            document.getElementById('quiz-tab').classList.add('active');
            document.getElementById('btn-tab-quiz').classList.add('active');
        }
    }

    function toggleExplanationDrawer() {
        const drawer = document.getElementById('explanation-drawer');
        const btn = document.getElementById('drawer-toggle-btn');
        explanationDrawerOpen = !explanationDrawerOpen;
        
        if (explanationDrawerOpen) {
            drawer.style.display = 'block';
            btn.textContent = "👆 Click to Collapse Mathematical Explanations Pane";
        } else {
            drawer.style.display = 'none';
            btn.textContent = "👇 Click to Reveal Step-by-Step Explanations Underneath";
        }
    }

    function openManual() { document.getElementById('manual-modal').style.display = 'flex'; }
    function closeManual() { document.getElementById('manual-modal').style.display = 'none'; }
    function closeManualOnOverlay(e) { if(e.target.id === 'manual-modal') closeManual(); }

    function copyValue(elementId) {
        const text = document.getElementById(elementId).textContent;
        navigator.clipboard.writeText(text).then(() => {
            alert("Copied directly to clipboard: " + text);
        });
    }

    function updateKeypadMasking() {
        document.querySelectorAll('.base-row').forEach(row => row.classList.remove('selected'));
        document.getElementById(`row-${activeBaseName}`).classList.add('selected');

        document.querySelectorAll('.key').forEach(keyButton => {
            const val = keyButton.textContent;
            if (val === 'AC') return;
            
            let isAllowed = false;
            if (activeBaseName === 'BIN') isAllowed = (val === '0' || val === '1');
            else if (activeBaseName === 'OCT') isAllowed = (val >= '0' && val <= '7');
            else if (activeBaseName === 'DEC') isAllowed = (val >= '0' && val <= '9');
            else if (activeBaseName === 'HEX') isAllowed = true;

            keyButton.disabled = !isAllowed;
            if (isAllowed) keyButton.classList.remove('grayed-out');
            else keyButton.classList.add('grayed-out');
        });
    }

    function changeActiveBase(baseName, radix) {
        activeBaseName = baseName;
        activeRadix = radix;
        updateKeypadMasking();
        updateDisplayValues();
        generateMathematicalExplanations();
    }

    function pressKey(char) {
        let currentStringValue = document.getElementById(`val-${activeBaseName}`).textContent;
        if (currentStringValue === '0') currentStringValue = '';
        
        let testString = currentStringValue + char;
        let parsedValue = parseInt(testString, activeRadix);
        
        if (parsedValue > 255) {
            alert("Boundary Warning: Maximum system design capacity limit is 255 (8-bit scale).");
            return;
        }

        internalDecimalValue = parsedValue;
        updateDisplayValues();
        generateMathematicalExplanations();
    }

    function clearCalculator() {
        internalDecimalValue = 0;
        updateDisplayValues();
        document.getElementById('steps-output').innerHTML = "Enter numbers above to compile visual explanation charts.";
    }

    function updateDisplayValues() {
        document.getElementById('val-BIN').textContent = internalDecimalValue.toString(2).toUpperCase();
        document.getElementById('val-OCT').textContent = internalDecimalValue.toString(8).toUpperCase();
        document.getElementById('val-DEC').textContent = internalDecimalValue.toString(10).toUpperCase();
        document.getElementById('val-HEX').textContent = internalDecimalValue.toString(16).toUpperCase();
    }
    function generateMathematicalExplanations() {
        const outputBox = document.getElementById('steps-output');
        if (internalDecimalValue === 0) {
            outputBox.innerHTML = "Value register evaluates to baseline zero across all conversions.";
            return;
        }

        let html = `<p style='margin-bottom:16px; font-family:"Montserrat",sans-serif; font-weight:600;'>Currently Analyzing Source System Base: <span style='color:var(--accent-dark);'>${activeBaseName}</span> (Decimal Value: ${internalDecimalValue})</p>`;

        // BLOCK A: TRANSLATION LOGS INTO DECIMAL
        if (activeBaseName !== 'DEC') {
            html += `<div class='conversion-block'><h4>➡️ Conversion Process Into DECIMAL (Base 10)</h4>`;
            html += `<p>Think of this like counting tokens grouped into stacks! We multiply each digit symbol by its column weight positional power:</p>`;
            html += `<table class='step-table'><tr><th>Digit Character</th>`;
            let str = internalDecimalValue.toString(activeRadix).toUpperCase();
            for(let i=0; i<str.length; i++) html += `<td><b>${str[i]}</b></td>`;
            html += `</tr><tr><th>Positional Multiplier</th>`;
            for(let i=str.length-1; i>=0; i--) html += `<td>${activeRadix}<sup>${i}</sup> (${Math.pow(activeRadix, i)})</td>`;
            html += `</tr></table><p style='margin-top:10px;'>Summation Equation String: `;
            let parts = [];
            for(let i=0; i<str.length; i++) {
                let d = parseInt(str[i], activeRadix);
                let p = Math.pow(activeRadix, str.length - 1 - i);
                parts.push(`(${d} × ${p})`);
            }
            html += parts.join(" + ") + ` = <b>${internalDecimalValue}</b></p></div>`;
        }

        // BLOCK B: TRANSLATION LOGS INTO BINARY
        if (activeBaseName !== 'BIN') {
            html += `<div class='conversion-block'><h4>➡️ Conversion Process Into BINARY (Base 2)</h4>`;
            html += `<p>Imagine you have 8 token baskets holding token values 128 down to 1. We fill a basket with a <b>1</b> if our tokens fit inside it, otherwise we leave a <b>0</b>:</p>`;
            html += `<div class='visual-box-container'>`;
            let binStr = internalDecimalValue.toString(2).padStart(8, '0');
            let wCheck = 128;
            for(let i=0; i<8; i++) {
                let bit = binStr[i];
                html += `<div class='visual-box ${bit==='1'?'active':''}'>${wCheck}<br><small>${bit}</small></div>`;
                wCheck /= 2;
            }
            html += `</div><p>Resulting Binary representation notation string value: <b>${binStr}</b></p></div>`;
        }

        // BLOCK C: TRANSLATION LOGS INTO OCTAL
        if (activeBaseName !== 'OCT') {
            html += `<div class='conversion-block'><h4>➡️ Conversion Process Into OCTAL (Base 8)</h4>`;
            html += `<p>We divide our decimal value size repeatedly by 8. We keep track of the remainder left behind at each station to form our final answer:</p>`;
            html += `<table class='step-table'><tr><th>Radix Station</th><th>Division Expression</th><th>Integer Quotient</th><th>Station Remainder</th></tr>`;
            let oTemp = internalDecimalValue;
            while(oTemp > 0) {
                html += `<tr><td>Octal (8)</td><td>${oTemp} ÷ 8</td><td>${Math.floor(oTemp/8)}</td><td><b>${oTemp % 8}</b></td></tr>`;
                oTemp = Math.floor(oTemp / 8);
            }
            html += `</table><p style='margin-top:8px;'>Resulting Octal notation string value: <b>${internalDecimalValue.toString(8)}</b></p></div>`;
        }

        // BLOCK D: TRANSLATION LOGS INTO HEXADECIMAL
        if (activeBaseName !== 'HEX') {
            html += `<div class='conversion-block'><h4>➡️ Conversion Process Into HEXADECIMAL (Base 16)</h4>`;
            html += `<p>We divide the standard decimal value size repeatedly by 16. If a remainder is 10 or higher, we swap it for a standard letter symbol (A=10, B=11...):</p>`;
            html += `<table class='step-table'><tr><th>Radix Station</th><th>Division Expression</th><th>Integer Quotient</th><th>Station Remainder</th></tr>`;
            let hTemp = internalDecimalValue;
            while(hTemp > 0) {
                let rem = hTemp % 16;
                let rStr = rem >= 10 ? String.fromCharCode(55 + rem) + ` (${rem})` : rem;
                html += `<tr><td>Hex (16)</td><td>${hTemp} ÷ 16</td><td>${Math.floor(hTemp/16)}</td><td><b>${rStr}</b></td></tr>`;
                hTemp = Math.floor(hTemp / 16);
            }
            html += `</table><p style='margin-top:8px;'>Resulting Hexadecimal notation string value: <b>${internalDecimalValue.toString(16).toUpperCase()}</b></p></div>`;
        }

        outputBox.innerHTML = html;
    }

    function generateQuizQuestion() {
        const bases = [
            { name: "Binary", radix: 2 },
            { name: "Octal", radix: 8 },
            { name: "Decimal", radix: 10 },
            { name: "Hexadecimal", radix: 16 }
        ];
        let srcIdx = Math.floor(Math.random() * 4);
        let tgtIdx;
        do { tgtIdx = Math.floor(Math.random() * 4); } while (tgtIdx === srcIdx);

        activeQuizDecimalValue = Math.floor(Math.random() * 254) + 1;
        activeQuizTargetRadix = bases[tgtIdx].radix;
        activeQuizAnswerKey = activeQuizDecimalValue.toString(activeQuizTargetRadix).toUpperCase();

        document.getElementById('quiz-prompt').innerHTML = 
            `Convert the source <b>${bases[srcIdx].name}</b> payload value: <span style='color:var(--accent-dark); font-family:"Roboto Mono",monospace; font-size:22px; display:block; margin:6px 0;'>${activeQuizDecimalValue.toString(bases[srcIdx].radix).toUpperCase()}</span> into its equivalent target <b>${bases[tgtIdx].name}</b> string parameter:`;
        
        document.getElementById('quiz-answer').value = "";
        document.getElementById('quiz-feedback').style.display = "none";
        document.getElementById('quiz-explanation-box').style.display = "none";
    }

    function submitQuizAnswer() {
        const input = document.getElementById('quiz-answer').value.trim().toUpperCase();
        const banner = document.getElementById('quiz-feedback');
        if(!input) return;

        quizTotal++;
        if(input === activeQuizAnswerKey) {
            quizCorrect++;
            banner.className = "feedback-banner success";
            banner.textContent = "Evaluation Success! Your calculation logs match system expectations perfectly.";
            banner.style.display = "block";
            setTimeout(generateQuizQuestion, 2000);
        } else {
            banner.className = "feedback-banner error";
            banner.textContent = `Incorrect result state string. The expected evaluation key was: ${activeQuizAnswerKey}`;
            banner.style.display = "block";
            renderQuizExplanation();
        }
        let pct = quizTotal > 0 ? Math.round((quizCorrect / quizTotal) * 100) : 0;
        document.getElementById('quiz-score').textContent = `Success Register: ${quizCorrect} / ${quizTotal} (${pct}%)`;
    }

    function resetQuizLogMetrics() {
        quizCorrect = 0;
        quizTotal = 0;
        document.getElementById('quiz-score').textContent = "Success Register: 0 / 0 (0%)";
        generateQuizQuestion();
    }

    function renderQuizExplanation() {
        const box = document.getElementById('quiz-explanation-box');
        box.style.display = "block";
        let html = "<h4>🎓 Step-by-Step Problem Resolution Table:</h4>";
        html += "<p>This problem translates to decimal value size: <b>" + activeQuizDecimalValue + "</b>.</p><table class='step-table'>";
        let calcVal = activeQuizDecimalValue;
        while(calcVal > 0) {
            html += "<tr><td>" + calcVal + " ÷ " + activeQuizTargetRadix + "</td><td>Station Remainder Leftover Digit: <b>" + (calcVal % activeQuizTargetRadix).toString(activeQuizTargetRadix).toUpperCase() + "</b></td></tr>";
            calcVal = Math.floor(calcVal / activeQuizTargetRadix);
        }
        html += "</table><button class='quiz-submit' style='margin-top:12px; width:100%;' onclick='generateQuizQuestion()'>Load Next Lab Exercise</button>";
        box.innerHTML = html;
    }
</script>
