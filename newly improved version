<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Number System Hub</title>
    <!-- Textbook Fonts Integration -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Montserrat:wght@400;500;700;800&family=Open+Sans:ital,wght@0,400;0,600;1,400&family=Roboto+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Educational Typography Theme Colors */
            --bg-primary: #121214;       /* Pure Obsidian Background */
            --bg-surface: #1E1A2A;       /* Muted Deep Purple Structure */
            --accent-dark: #A5B4FC;      /* Pale Lavender Blue Accent (CTAs) */
            --accent-muted: #56507A;     /* Soft Structural Purple Tones */
            --text-main: #EAEAEA;        /* Soft Off-White Textbook Typography */
            --text-muted: #A8A2B5;       /* Subdued Explanatory Copy Tint */
            --text-dark: #121214;        /* Dark Obsidian Ink for Light Overlays */
            --gray-disabled: #161220;    /* Muted Inactive Component Masking */
            --border: #3A354D;           /* Clean Hairline Grid Dividers */
            --correct: #81C784;          /* Soft Instructional Affirmation Green */
            --incorrect: #FF8A80;        /* Soft Instructional Rectification Red */
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            font-family: 'Open Sans', sans-serif;
            font-size: 15px;
            line-height: 1.6;
            padding: 20px;
        }
        .container {
            width: 100%;
            max-width: 1150px;
            background-color: var(--bg-surface);
            border-radius: 14px;
            padding: 28px;
            margin: 20px auto;
            box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
            border: 1px solid var(--border);
        }

        header {
            text-align: center;
            margin-bottom: 28px;
            border-bottom: 2px solid var(--accent-dark);
            padding-bottom: 18px;
            position: relative;
        }

        header h1 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            color: var(--accent-dark);
            font-size: 30px;
            margin-bottom: 6px;
            letter-spacing: -0.5px;
        }

        header p {
            color: var(--text-muted);
            font-style: italic;
            font-size: 14px;
        }

        .manual-trigger-btn {
            position: absolute;
            right: 0;
            top: 6px;
            background-color: var(--accent-dark);
            color: var(--text-dark);
            border: none;
            padding: 8px 18px;
            border-radius: 6px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            cursor: pointer;
            font-size: 13px;
            box-shadow: 0 4px 14px rgba(165, 180, 252, 0.2);
            transition: all 0.2s ease;
        }

        .manual-trigger-btn:hover {
            background-color: var(--text-main);
            transform: translateY(-1px);
        }

        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 24px;
        }

        .tab-btn {
            flex: 1;
            padding: 14px;
            background: #161220;
            border: 1px solid var(--border);
            color: var(--text-muted);
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 13px;
            letter-spacing: 0.5px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .tab-btn.active {
            background: var(--accent-dark);
            color: var(--text-dark);
            border-color: var(--accent-dark);
        }
        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .calc-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 24px;
        }

        @media (min-width: 900px) {
            .calc-layout {
                grid-template-columns: 1.1fr 1fr;
            }
        }

        .display-panel {
            background: var(--bg-primary);
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            border: 1px solid var(--border);
        }

        .base-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            border-bottom: 1px solid rgba(58, 53, 77, 0.4);
            gap: 16px;
        }

        .base-row:last-child {
            border-bottom: none;
        }

        .base-label {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 13px;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        .value-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-grow: 1;
            justify-content: flex-end;
            min-width: 0;
        }

        .base-value {
            font-size: 21px;
            font-family: 'Roboto Mono', monospace;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: var(--accent-dark);
        }

        .copy-btn {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            color: var(--accent-dark);
            padding: 4px 10px;
            font-size: 11px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.15s ease;
            flex-shrink: 0;
        }

        .copy-btn:hover {
            background: var(--accent-muted);
            color: var(--text-main);
        }

        .base-row.selected {
            background: rgba(165, 180, 252, 0.05);
            border-radius: 6px;
        }

        .base-row.selected .base-label {
            color: var(--accent-dark);
        }

        .base-selector {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .base-radio {
            flex: 1;
            text-align: center;
        }

        .base-radio input {
            display: none;
        }

        .base-radio label {
            display: block;
            padding: 12px 6px;
            background: #161220;
            border: 1px solid var(--border);
            border-radius: 6px;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 12px;
            color: var(--text-muted);
            transition: all 0.2s;
        }

        .base-radio input:checked + label {
            background: var(--accent-dark);
            color: var(--text-dark);
            border-color: var(--accent-dark);
        }

        .keypad {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .key {
            padding: 16px 10px;
            background: #161220;
            border: 1px solid var(--border);
            color: var(--text-main);
            font-family: 'Roboto Mono', monospace;
            font-size: 18px;
            font-weight: 700;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.1s;
        }

        .key.action-key {
            background: var(--accent-muted);
            border-color: rgba(165, 180, 252, 0.2);
        }

        .key.clear-key {
            background: rgba(239, 83, 80, 0.1);
            color: #ef5350;
            border-color: rgba(239, 83, 80, 0.2);
        }

        .key:disabled, .key.grayed-out {
            background: var(--gray-disabled) !important;
            color: #3D384D !important;
            border-color: #14111E !important;
            opacity: 0.3;
            cursor: not-allowed;
            pointer-events: none;
        }
        .steps-panel {
            background: var(--bg-primary);
            padding: 22px;
            border-radius: 10px;
            border: 1px solid var(--border);
            max-height: 560px;
            overflow-y: auto;
        }

        .steps-panel h3 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 16px;
            color: var(--accent-dark);
            margin-bottom: 14px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 6px;
        }

        .textbook-text {
            font-size: 14.5px;
            color: var(--text-main);
            margin-bottom: 14px;
            text-align: justify;
        }

        .textbook-text b {
            color: var(--accent-dark);
        }

        .textbook-example {
            background: #161220;
            border-left: 3px solid var(--accent-dark);
            padding: 12px;
            margin: 14px 0;
            font-size: 13.5px;
            border-radius: 0 6px 6px 0;
        }

        .textbook-example p {
            font-family: 'Roboto Mono', monospace;
            color: var(--text-muted);
        }

        .step-table {
            width: 100%;
            border-collapse: collapse;
            margin: 14px 0;
            font-size: 13px;
            background: #161220;
        }

        .step-table th, .step-table td {
            border: 1px solid var(--border);
            padding: 10px;
            text-align: left;
        }

        .step-table th {
            background: var(--accent-muted);
            color: var(--text-main);
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
        }

        .step-table td {
            font-family: 'Roboto Mono', monospace;
        }

        .textbook-note {
            font-size: 12px;
            color: var(--text-muted);
            font-style: italic;
            margin-top: 6px;
        }

        .summary-table-section {
            margin-top: 28px;
            background: var(--bg-primary);
            padding: 20px;
            border-radius: 10px;
            border: 1px solid var(--border);
        }

        .summary-table-section h3 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 16px;
            margin-bottom: 10px;
            color: var(--accent-dark);
        }

        .quiz-card {
            background: var(--bg-primary);
            padding: 28px;
            border-radius: 10px;
            border: 1px solid var(--border);
            text-align: center;
        }

        .quiz-question {
            font-size: 18px;
            margin-bottom: 20px;
        }

        .quiz-input-group {
            display: flex;
            max-width: 420px;
            margin: 0 auto 20px auto;
            gap: 10px;
        }

        .quiz-field {
            flex: 1;
            padding: 12px;
            background: #161220;
            border: 1px solid var(--border);
            color: var(--text-main);
            font-family: 'Roboto Mono', monospace;
            font-size: 18px;
            font-weight: 700;
            border-radius: 6px;
            text-transform: uppercase;
            text-align: center;
            outline: none;
        }

        .quiz-field:focus {
            border-color: var(--accent-dark);
        }

        .quiz-submit {
            padding: 12px 28px;
            background: var(--accent-dark);
            border: none;
            color: var(--text-dark);
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            border-radius: 6px;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        .quiz-submit:hover {
            opacity: 0.9;
        }

        .feedback-banner {
            padding: 14px;
            border-radius: 6px;
            margin-top: 14px;
            font-weight: bold;
            font-size: 14px;
            display: none;
            text-align: left;
        }

        .feedback-banner.success {
            display: block;
            background: rgba(129, 199, 132, 0.1);
            color: var(--correct);
            border-left: 4px solid var(--correct);
        }

        .feedback-banner.error {
            display: block;
            background: rgba(255, 138, 128, 0.1);
            color: var(--incorrect);
            border-left: 4px solid var(--incorrect);
        }

        .score-counter {
            font-size: 14px;
            color: var(--text-muted);
            margin-top: 14px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.75);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 15px;
            backdrop-filter: blur(4px);
        }

        .modal-content {
            background: var(--bg-surface);
            border: 2px solid var(--accent-dark);
            border-radius: 12px;
            max-width: 680px;
            width: 100%;
            padding: 26px;
            box-shadow: 0 24px 64px rgba(0,0,0,0.6);
            position: relative;
            max-height: 85vh;
            overflow-y: auto;
        }

        .modal-content h2 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            color: var(--accent-dark);
            margin-bottom: 14px;
            border-bottom: 2px solid var(--accent-muted);
            padding-bottom: 6px;
            font-size: 22px;
        }

        .modal-content h3 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            margin: 16px 0 6px 0;
            font-size: 15px;
            color: var(--accent-dark);
        }

        .modal-content p, .modal-content li {
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 8px;
            color: var(--text-main);
        }

        .modal-content ul {
            margin-left: 22px;
        }

        .close-modal-btn {
            background-color: var(--accent-dark);
            color: var(--text-dark);
            border: none;
            padding: 10px 22px;
            border-radius: 6px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            cursor: pointer;
            float: right;
            margin-top: 15px;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Number System Hub</h1>
        <p>A Structured Introduction to Digital Logics & Radix Algebra</p>
        <button class="manual-trigger-btn" onclick="openManual()">📖 User Manual</button>
    </header>

    <div class="tabs">
        <button id="btn-tab-calc" class="tab-btn active" onclick="switchTab('calc')">Interactive Laboratory</button>
        <button id="btn-tab-quiz" class="tab-btn" onclick="switchTab('quiz')">Academic Assessment</button>
    </div>

    <!-- CALCULATOR CONTENT -->
    <div id="calc-tab" class="tab-content active">
        <div class="calc-layout">
            <div>
                <div class="base-selector">
                    <div class="base-radio">
                        <input type="radio" id="src-bin" name="src-base" value="2" onchange="changeActiveBase('BIN', 2)">
                        <label for="src-bin">BIN (Base 2)</label>
                    </div>
                    <div class="base-radio">
                        <input type="radio" id="src-oct" name="src-base" value="8" onchange="changeActiveBase('OCT', 8)">
                        <label for="src-oct">OCT (Base 8)</label>
                    </div>
                    <div class="base-radio">
                        <input type="radio" id="src-dec" name="src-base" value="10" checked onchange="changeActiveBase('DEC', 10)">
                        <label for="src-dec">DEC (Base 10)</label>
                    </div>
                    <div class="base-radio">
                        <input type="radio" id="src-hex" name="src-base" value="16" onchange="changeActiveBase('HEX', 16)">
                        <label for="src-hex">HEX (Base 16)</label>
                    </div>
                </div>

                <div class="display-panel">
                    <div class="base-row" id="row-BIN">
                        <span class="base-label">BIN</span>
                        <div class="value-wrapper">
                            <span class="base-value" id="val-BIN">0</span>
                            <button class="copy-btn" onclick="copyValue('val-BIN')">Copy</button>
                        </div>
                    </div>
                    <div class="base-row" id="row-OCT">
                        <span class="base-label">OCT</span>
                        <div class="value-wrapper">
                            <span class="base-value" id="val-OCT">0</span>
                            <button class="copy-btn" onclick="copyValue('val-OCT')">Copy</button>
                        </div>
                    </div>
                    <div class="base-row" id="row-DEC">
                        <span class="base-label">DEC</span>
                        <div class="value-wrapper">
                            <span class="base-value" id="val-DEC">0</span>
                            <button class="copy-btn" onclick="copyValue('val-DEC')">Copy</button>
                        </div>
                    </div>
                    <div class="base-row" id="row-HEX">
                        <span class="base-label">HEX</span>
                        <div class="value-wrapper">
                            <span class="base-value" id="val-HEX">0</span>
                            <button class="copy-btn" onclick="copyValue('val-HEX')">Copy</button>
                        </div>
                    </div>
                </div>

                <div class="keypad">
                    <button class="key action-key" onclick="pressKey('D')">D</button>
                    <button class="key action-key" onclick="pressKey('E')">E</button>
                    <button class="key action-key" onclick="pressKey('F')">F</button>
                    <button class="key clear-key" onclick="clearCalculator()">AC</button>
                    <button class="key action-key" onclick="pressKey('A')">A</button>
                    <button class="key action-key" onclick="pressKey('B')">B</button>
                    <button class="key action-key" onclick="pressKey('C')">C</button>
                    <button class="key" onclick="pressKey('9')">9</button>
                    <button class="key" onclick="pressKey('8')">8</button>
                    <button class="key" onclick="pressKey('7')">7</button>
                    <button class="key" onclick="pressKey('6')">6</button>
                    <button class="key" onclick="pressKey('5')">5</button>
                    <button class="key" onclick="pressKey('4')">4</button>
                    <button class="key" onclick="pressKey('3')">3</button>
                    <button class="key" onclick="pressKey('2')">2</button>
                    <button class="key" onclick="pressKey('1')">1</button>
                    <button class="key" style="grid-column: span 4;" onclick="pressKey('0')">0</button>
                </div>
            </div>
            <div>
                <div class="steps-panel" style="margin-bottom: 16px;">
                    <div id="base-explanation-box" class="textbook-text"></div>
                </div>
                <div class="steps-panel">
                    <h3>Analytical Derivations</h3>
                    <div id="steps-output" class="textbook-text" style="color: var(--text-muted);">
                        Select your baseline parameters on the left to reveal corresponding mathematical derivations and place-value structural mappings.
                    </div>
                </div>
            </div>
        </div>

        <div class="summary-table-section">
            <h3>Reference Matrix Summary (0 - 15 Baseline Progression)</h3>
            <p class="textbook-text" style="font-size: 13.5px; color: var(--text-muted); margin-bottom: 8px;">
                Review the comparative structure of standard numerical values across all core architectures. Observe how the characters line up perfectly:
            </p>
            <table class="step-table" style="margin-top: 0;">
                <thead>
                    <tr>
                        <th>Decimal (DEC)</th>
                        <th>Binary (BIN)</th>
                        <th>Octal (OCT)</th>
                        <th>Hexadecimal (HEX)</th>
                    </tr>
                </thead>
                <tbody id="summary-table-body"></tbody>
            </table>
        </div>
    </div>

    <!-- QUIZ CONTENT -->
    <div id="quiz-tab" class="tab-content">
        <div class="quiz-card">
            <div class="quiz-question textbook-text" id="quiz-prompt" style="text-align: center; font-size: 17px;">Generating assignment...</div>
            <div class="quiz-input-group">
                <input type="text" id="quiz-answer" class="quiz-field" placeholder="Enter solution..." autocomplete="off">
                <button class="quiz-submit" onclick="submitQuizAnswer()">Submit</button>
            </div>
            <div id="quiz-feedback" class="feedback-banner"></div>
            <div id="quiz-score" class="score-counter">Score: 0 / 0</div>
            <div id="quiz-explanation-box" class="steps-panel" style="margin-top: 24px; display: none; text-align: left;"></div>
        </div>
    </div>
</div>

<div id="manual-modal" class="modal-overlay" onclick="closeManualOnOverlay(event)">
    <div class="modal-content">
        <h2>📖 User Manual & Beginners Guide</h2>
        <p>This textbook platform serves as an interactive sandbox to study the underlying behavior of digital number networks. Follow this checklist to begin your study session:</p>
        
        <h3>🔬 The Laboratory Laboratory</h3>
        <ul>
            <li><b>Switch Base Anchors:</b> Click any base button (BIN, OCT, DEC, HEX) to choose your target input data layout.</li>
            <li><b>Observe the Keypad Constraint Engine:</b> Notice how invalid digits are greyed out programmatically! When entering <b>Binary</b>, keys 2–9 and A–F freeze instantly because Base 2 mathematics acknowledges only 0 and 1. This prevents errors as you compose numbers!</li>
            <li><b>Textbook Derivations:</b> Enter a value and read the derivations screen on the right. It parses your input using clear, textbook-style prose and charts.</li>
            <li><b>Single-Click Clipboard Save:</b> Click the <b>Copy</b> button right next to any layout display field to lock that translated character string straight onto your system clipboard.</li>
        </ul>

        <h3>📝 Self-Assessment Practice Mode</h3>
        <ul>
            <li>Click the <b>Academic Assessment</b> tab at the top to clear the board.</li>
            <li>The system dynamically constructs a customized base translation question bounded between 0 and 255.</li>
            <li>Calculate the conversion manually on your paper and submit your answer. If you get stuck, the application will reveal a complete step-by-step division breakdown table to guide you back to the right answer.</li>
        </ul>
        <button class="close-modal-btn" onclick="closeManual()">Return to Laboratory</button>
    </div>
</div>
<script>
    let activeBaseName = 'DEC';
    let activeRadix = 10;
    let internalDecimalValue = 0;

    let quizCorrect = 0;
    let quizTotal = 0;
    let activeQuizAnswerKey = "";
    let activeQuizDecimalValue = 0;
    let activeQuizTargetRadix = 10;

    window.onload = function() {
        updateKeypadMasking();
        generateQuizQuestion();
        buildSummaryConversionMatrix();
        updateBaseContextExplanation();
    };

    function switchTab(tabId) {
        document.getElementById('calc-tab').classList.remove('active');
        document.getElementById('quiz-tab').classList.remove('active');
        document.getElementById('btn-tab-calc').classList.remove('active');
        document.getElementById('btn-tab-quiz').classList.remove('active');
        
        if(tabId === 'calc') {
            document.getElementById('calc-tab').classList.add('active');
            document.getElementById('btn-tab-calc').classList.add('active');
        } else {
            document.getElementById('quiz-tab').classList.add('active');
            document.getElementById('btn-tab-quiz').classList.add('active');
        }
    }

    function openManual() {
        document.getElementById('manual-modal').style.display = 'flex';
    }

    function closeManual() {
        document.getElementById('manual-modal').style.display = 'none';
    }

    function closeManualOnOverlay(e) {
        if(e.target.id === 'manual-modal') closeManual();
    }

    function copyValue(elementId) {
        const textToCopy = document.getElementById(elementId).textContent;
        navigator.clipboard.writeText(textToCopy).then(() => {
            alert("Copied to clipboard: " + textToCopy);
        }).catch(err => {
            console.error("Failed to copy text: ", err);
        });
    }

    function updateKeypadMasking() {
        document.querySelectorAll('.base-row').forEach(row => row.classList.remove('selected'));
        document.getElementById(`row-${activeBaseName}`).classList.add('selected');

        document.querySelectorAll('.key').forEach(keyButton => {
            const val = keyButton.textContent;
            if (val === 'AC') return;
            
            let isAllowed = false;
            if (activeBaseName === 'BIN') isAllowed = (val === '0' || val === '1');
            else if (activeBaseName === 'OCT') isAllowed = (val >= '0' && val <= '7');
            else if (activeBaseName === 'DEC') isAllowed = (val >= '0' && val <= '9');
            else if (activeBaseName === 'HEX') isAllowed = true;

            if (isAllowed) {
                keyButton.disabled = false;
                keyButton.classList.remove('grayed-out');
            } else {
                keyButton.disabled = true;
                keyButton.classList.add('grayed-out');
            }
        });
    }

    function changeActiveBase(baseName, radix) {
        activeBaseName = baseName;
        activeRadix = radix;
        updateKeypadMasking();
        updateDisplayValues();
        generateMathematicalExplanations();
        updateBaseContextExplanation();
    }

    function updateBaseContextExplanation() {
        const box = document.getElementById('base-explanation-box');
        let title = "", details = "";
        
        if (activeBaseName === 'BIN') {
            title = "The Binary Structural Concept (Base 2)";
            details = "Binary is the internal language of computer circuitry. It uses only two digits, <b>0</b> and <b>1</b>, to represent 'off' and 'on' electrical states. Because there are only two digits, each place value column doubles as you move left, scaling exponentially from 1 to 2, 4, 8, 16, and beyond.";
        } else if (activeBaseName === 'OCT') {
            title = "The Octal Structural Concept (Base 8)";
            details = "Octal utilizes exactly eight positional symbols, numbered <b>0 through 7</b>. In digital architecture, it acts as a shorthand to group long, complex binary strings into neat chunks of three bits each.";
        } else if (activeBaseName === 'DEC') {
            title = "The Decimal Structural Concept (Base 10)";
            details = "Decimal is the baseline counting framework used by humans every day. It features 10 characters, running from <b>0 through 9</b>. Each position increases ten-fold as you move left (1s, 10s, 100s, 1000s), which likely evolved from counting on our ten fingers.";
        } else if (activeBaseName === 'HEX') {
            title = "The Hexadecimal Structural Concept (Base 16)";
            details = "Hexadecimal streamlines complex binary notation by grouping bits into chunks of four. Because it requires 16 unique symbols, it uses digits <b>0–9</b> for the first ten values, and letters <b>A through F</b> to represent values 10 through 15 (where A=10, B=11, C=12, D=13, E=14, F=15).";
        }
        
        box.innerHTML = `<h3 style='color:var(--accent-dark); font-family:\"Montserrat\", sans-serif; margin-bottom:6px;'>${title}</h3><p style='color:var(--text-main); font-size:14px; text-align:justify;'>${details}</p>`;
    }
</script>
<script>
    function pressKey(char) {
        let currentStringValue = document.getElementById(`val-${activeBaseName}`).textContent;
        if (currentStringValue === '0') currentStringValue = '';
        
        let testString = currentStringValue + char;
        let parsedValue = parseInt(testString, activeRadix);
        
        if (parsedValue > 255) {
            alert("Boundary Alert: This system is capped at an 8-bit maximum range of 255.");
            return;
        }

        internalDecimalValue = parsedValue;
        updateDisplayValues();
        generateMathematicalExplanations();
    }

    function clearCalculator() {
        internalDecimalValue = 0;
        updateDisplayValues();
        document.getElementById('steps-output').innerHTML = "Select your baseline parameters on the left to reveal corresponding mathematical derivations and place-value structural mappings.";
    }

    function updateDisplayValues() {
        document.getElementById('val-BIN').textContent = internalDecimalValue.toString(2).toUpperCase();
        document.getElementById('val-OCT').textContent = internalDecimalValue.toString(8).toUpperCase();
        document.getElementById('val-DEC').textContent = internalDecimalValue.toString(10).toUpperCase();
        document.getElementById('val-HEX').textContent = internalDecimalValue.toString(16).toUpperCase();
    }

    function generateMathematicalExplanations() {
        const outputBox = document.getElementById('steps-output');
        if (internalDecimalValue === 0) {
            outputBox.innerHTML = "Value is 0. Conversions remain baseline zero.";
            return;
        }

        let html = "<p style='margin-bottom:12px;'>Let's analyze the properties of the baseline decimal value <b>" + internalDecimalValue + "</b>.</p>";
        html += "<p><b>1. Positional Bit-Weight Evaluation</b><br>To convert a base-10 integer into binary, we test it against standard 8-bit positional weights. We write a <b>1</b> if the weight fits inside our remaining value, and a <b>0</b> if it does not:</p>";
        
        html += "<table class='step-table'><thead><tr><th>Bit Weights</th><th>128</th><th>64</th><th>32</th><th>16</th><th>8</th><th>4</th><th>2</th><th>1</th></tr></thead><tbody><tr><td>Code State</td>";
        
        let tempVal = internalDecimalValue;
        for (let w = 128; w >= 1; w = w / 2) {
            if (tempVal >= w) {
                html += "<td style='color:var(--accent-dark); font-weight:bold; background: rgba(165,180,252,0.15);'>1</td>";
                tempVal -= w;
            } else {
                html += "<td>0</td>";
            }
        }
        html += "</tr></tbody></table>";

        html += "<p><b>2. Successive Remainder Radix Division</b><br>To convert our value into Octal or Hexadecimal, we divide the decimal integer repeatedly by the new target base. We record the integer quotient for the next line, and keep the leftover remainder as our digit:</p>";
        html += "<table class='step-table'><thead><tr><th>Radix Type</th><th>Division Expression</th><th>Quotient Out</th><th>Remainder</th></tr></thead><tbody>";
        
        let octTemp = internalDecimalValue;
        while (octTemp > 0) {
            html += "<tr><td>Octal (Base 8)</td><td>" + octTemp + " ÷ 8</td><td>" + Math.floor(octTemp/8) + "</td><td><b>" + (octTemp % 8) + "</b></td></tr>";
            octTemp = Math.floor(octTemp / 8);
        }

        let hexTemp = internalDecimalValue;
        while (hexTemp > 0) {
            let rem = hexTemp % 16;
            let hexChar = rem.toString(16).toUpperCase();
            html += "<tr><td>Hexadecimal (Base 16)</td><td>" + hexTemp + " ÷ 16</td><td>" + Math.floor(hexTemp/16) + "</td><td><b>" + hexChar + " (" + rem + ")</b></td></tr>";
            hexTemp = Math.floor(hexTemp / 16);
        }
        
        html += "</tbody></table><p class='textbook-note'>Note: Read the remainders from the bottom row upward to build the final converted string!</p>";
        outputBox.innerHTML = html;
    }

    function buildSummaryConversionMatrix() {
        const tbody = document.getElementById('summary-table-body');
        let html = "";
        for (let i = 0; i <= 15; i++) {
            html += `<tr>
                <td><b>${i}</b></td>
                <td>${i.toString(2).padStart(4, '0')}</td>
                <td>${i.toString(8)}</td>
                <td><b>${i.toString(16).toUpperCase()}</b></td>
            </tr>`;
        }
        tbody.innerHTML = html;
    }

    function generateQuizQuestion() {
        const bases = [
            { name: "Binary", radix: 2 },
            { name: "Octal", radix: 8 },
            { name: "Decimal", radix: 10 },
            { name: "Hexadecimal", radix: 16 }
        ];

        let srcIdx = Math.floor(Math.random() * 4);
        let tgtIdx;
        do { tgtIdx = Math.floor(Math.random() * 4); } while (tgtIdx === srcIdx);

        activeQuizDecimalValue = Math.floor(Math.random() * 254) + 1;
        activeQuizTargetRadix = bases[tgtIdx].radix;
        activeQuizAnswerKey = activeQuizDecimalValue.toString(activeQuizTargetRadix).toUpperCase();

        document.getElementById('quiz-prompt').innerHTML = 
            "Problem Challenge: Convert the <b>" + bases[srcIdx].name + "</b> value <b style='color:var(--accent-dark); font-family:monospace;'>" + activeQuizDecimalValue.toString(bases[srcIdx].radix).toUpperCase() + "</b> into its equivalent notation in the <b>" + bases[tgtIdx].name + "</b> system:";
        
        document.getElementById('quiz-answer').value = "";
        document.getElementById('quiz-feedback').style.display = "none";
        document.getElementById('quiz-explanation-box').style.display = "none";
    }

    function submitQuizAnswer() {
        const input = document.getElementById('quiz-answer').value.trim().toUpperCase();
        const banner = document.getElementById('quiz-feedback');
        if(!input) return;

        quizTotal++;
        if(input === activeQuizAnswerKey) {
            quizCorrect++;
            banner.className = "feedback-banner success";
            banner.textContent = "Correct! Your conversion perfectly satisfies the radix algebra criteria.";
            banner.style.display = "block";
            setTimeout(generateQuizQuestion, 2000);
        } else {
            banner.className = "feedback-banner error";
            banner.textContent = "Incorrect. The expected mathematical string solution was: " + activeQuizAnswerKey;
            banner.style.display = "block";
            renderQuizExplanation();
        }
        document.getElementById('quiz-score').textContent = "Score: " + quizCorrect + " / " + quizTotal;
    }

    function renderQuizExplanation() {
        const box = document.getElementById('quiz-explanation-box');
        box.style.display = "block";
        let html = "<h4>🎓 Textbook Remediation Matrix:</h4>";
        html += "<p>The question prompt targets base decimal value <b>" + activeQuizDecimalValue + "</b>. Here is the successive division tree:</p><table class='step-table'><thead><tr><th>Operation Expression</th><th>Leftover Remainder</th></tr></thead><tbody>";
        
        let calcVal = activeQuizDecimalValue;
        while(calcVal > 0) {
            let rem = calcVal % activeQuizTargetRadix;
            html += "<tr><td>" + calcVal + " ÷ " + activeQuizTargetRadix + "</td><td>Remainder: <b>" + rem.toString(activeQuizTargetRadix).toUpperCase() + "</b></td></tr>";
            calcVal = Math.floor(calcVal / activeQuizTargetRadix);
        }
        html += "</tbody></table><button class='quiz-submit' style='margin-top:12px; width:100%;' onclick='generateQuizQuestion()'>Advance to Next Problem</button>";
        box.innerHTML = html;
    }
</script>
</body>
</html>
