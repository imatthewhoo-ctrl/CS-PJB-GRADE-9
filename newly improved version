<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Number System Hub</title>
    <!-- Textbook Quality Typography Embedding -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Montserrat:wght@400;600;800&family=Open+Sans:wght@400;600&family=Roboto+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #121214;       
            --bg-surface: #1E1A2A;       
            --accent-dark: #A5B4FC;      
            --accent-muted: #5650A6;     
            --accent-fresh: #241D52;     
            --text-main: #EAEAEA;        
            --text-muted: #A3A3C2;       
            --text-light: #121214;       
            --gray-disabled: #181522;    
            --border: #3A355C;           
            --correct: #81C784;          
            --incorrect: #FF8A80;        
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            font-family: 'Open Sans', sans-serif;
            padding: 24px;
            line-height: 1.6;
        }
        .container {
            width: 100%;
            max-width: 1050px;
            background-color: var(--bg-surface);
            border-radius: 20px;
            padding: 32px;
            margin: 20px auto;
            box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
            border: 1px solid var(--border);
        }

        header {
            text-align: center;
            margin-bottom: 32px;
            border-bottom: 2px solid var(--border);
            padding-bottom: 20px;
            position: relative;
        }

        header h1 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            color: var(--accent-dark);
            font-size: 32px;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        header p {
            color: var(--text-muted);
            font-size: 15px;
        }

        .manual-trigger-btn {
            position: absolute;
            right: 0;
            top: 10px;
            background-color: var(--accent-dark);
            color: var(--text-light);
            border: none;
            padding: 10px 20px;
            border-radius: 24px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            box-shadow: 0 4px 14px rgba(165, 180, 252, 0.3);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .manual-trigger-btn:hover {
            background-color: #C7D2FE;
            transform: translateY(-2px);
        }

        .tabs {
            display: flex;
            gap: 12px;
            margin-bottom: 28px;
        }
        .tab-btn {
            flex: 1;
            padding: 14px;
            background: #151221;
            border: 1px solid var(--border);
            color: var(--text-muted);
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 14px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .tab-btn:hover {
            color: var(--text-main);
            border-color: var(--accent-dark);
        }

        .tab-btn.active {
            background: var(--accent-dark);
            color: var(--text-light);
            border-color: var(--accent-dark);
            box-shadow: 0 4px 16px rgba(165, 180, 252, 0.2);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .calc-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 28px;
            margin-bottom: 24px;
        }

        .display-panel {
            background: var(--bg-primary);
            padding: 20px;
            border-radius: 14px;
            margin-bottom: 20px;
            border: 2px solid var(--border);
        }

        .base-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            border-bottom: 1px solid rgba(58, 53, 92, 0.4);
            gap: 16px;
        }

        .base-row:last-child {
            border-bottom: none;
        }

        .base-row.selected {
            background: rgba(165, 180, 252, 0.06);
            border-radius: 8px;
            border-bottom-color: transparent;
        }

        .base-label {
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 13px;
            color: var(--text-muted);
            width: 50px;
        }

        .base-row.selected .base-label {
            color: var(--accent-dark);
        }
        .value-wrapper {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-grow: 1;
            justify-content: flex-end;
            min-width: 0;
        }

        .base-value {
            font-size: 20px;
            font-family: 'Roboto Mono', monospace;
            font-weight: 700;
            white-space: nowrap;
            overflow-x: auto;
            text-overflow: clip;
            color: var(--text-main);
            max-width: 100%;
        }

        .copy-btn {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            color: var(--accent-dark);
            padding: 6px 12px;
            font-family: 'Montserrat', sans-serif;
            font-size: 11px;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .copy-btn:hover {
            background: var(--accent-muted);
            color: var(--text-main);
        }

        .base-selector {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .base-radio {
            flex: 1;
        }

        .base-radio input {
            display: none;
        }

        .base-radio label {
            display: block;
            padding: 14px 6px;
            background: #151221;
            border: 1px solid var(--border);
            border-radius: 8px;
            text-align: center;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 13px;
            color: var(--text-muted);
            transition: all 0.2s;
        }

        .base-radio input:checked + label {
            background: var(--accent-dark);
            color: var(--text-light);
            border-color: var(--accent-dark);
        }
        .keypad {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .key {
            padding: 20px 10px;
            background: #151221;
            border: 1px solid var(--border);
            color: var(--text-main);
            font-family: 'Roboto Mono', monospace;
            font-size: 20px;
            font-weight: 700;
            border-radius: 10px;
            cursor: pointer;
            transition: background 0.15s, transform 0.1s;
        }

        .key:active {
            transform: scale(0.97);
        }

        .key.action-key {
            background: var(--accent-fresh);
            color: var(--accent-dark);
            border-color: var(--accent-muted);
        }

        .key.clear-key {
            background: rgba(255, 138, 128, 0.08);
            color: var(--incorrect);
            border-color: rgba(255, 138, 128, 0.2);
        }

        .key:disabled, .key.grayed-out {
            background: var(--gray-disabled) !important;
            color: #3D3552 !important;
            border-color: #151221 !important;
            opacity: 0.3;
            cursor: not-allowed;
            transform: none !important;
        }

        .explanation-trigger-pane {
            text-align: center;
            margin: 20px 0;
        }

        .popup-toggle-btn {
            background: var(--accent-fresh);
            border: 2px solid var(--accent-dark);
            color: var(--accent-dark);
            padding: 14px 28px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 15px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
            width: 100%;
        }

        .popup-toggle-btn:hover {
            background: var(--accent-dark);
            color: var(--text-light);
        }
        .steps-drawer-modal {
            background: #161322;
            padding: 24px;
            border-radius: 16px;
            border: 2px solid var(--accent-dark);
            margin-top: 20px;
            display: none;
            box-shadow: inset 0 4px 20px rgba(0,0,0,0.4);
        }

        .steps-drawer-modal h3 {
            font-family: 'Montserrat', sans-serif;
            font-size: 18px;
            margin-bottom: 20px;
            color: var(--accent-dark);
            border-bottom: 1px solid var(--border);
            padding-bottom: 8px;
        }

        .conversion-block {
            background: var(--bg-primary);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 24px;
            width: 100%;
            overflow: hidden;
        }

        .conversion-block h4 {
            font-family: 'Montserrat', sans-serif;
            font-size: 16px;
            color: var(--accent-dark);
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-left: 4px solid var(--accent-dark);
            padding-left: 8px;
        }

        /* ABSOLUTE FIX: Stops long numerical calculations from exploding outward */
        .conversion-block p, .conversion-block div {
            word-wrap: break-word;
            word-break: break-all;
            white-space: normal;
        }

        .table-scroll-wrapper {
            width: 100%;
            overflow-x: auto;
            margin: 12px 0;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: #151221;
        }

        .visual-box-container {
            display: flex;
            gap: 8px;
            padding: 12px;
            min-width: max-content;
        }

        .visual-box {
            background: var(--accent-fresh);
            border: 1px solid var(--accent-dark);
            color: var(--accent-dark);
            font-family: 'Roboto Mono', monospace;
            font-weight: 700;
            padding: 8px 14px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border-radius: 6px;
            font-size: 12px;
            min-width: 75px;
        }

        .visual-box.active {
            background: var(--accent-dark);
            color: var(--text-light);
        }

        .step-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            font-family: 'Roboto Mono', monospace;
            min-width: max-content;
        }

        .step-table th, .step-table td {
            border: 1px solid var(--border);
            padding: 12px 16px;
            text-align: left;
            white-space: nowrap;
        }

        .step-table th {
            background: rgba(165, 180, 252, 0.08);
            color: var(--text-muted);
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
        }
        .summary-table-section {
            margin-top: 24px;
            background: var(--bg-primary);
            padding: 20px;
            border-radius: 12px;
            border: 2px solid var(--border);
        }

        .summary-table-section h3 {
            font-family: 'Montserrat', sans-serif;
            margin-bottom: 10px;
            font-size: 16px;
            color: var(--accent-dark);
        }

        .quiz-card {
            background: var(--bg-primary);
            padding: 32px;
            border-radius: 16px;
            border: 2px solid var(--border);
            text-align: center;
        }

        .quiz-question {
            font-size: 20px;
            margin-bottom: 20px;
            font-family: 'Open Sans', sans-serif;
        }

        .quiz-input-group {
            display: flex;
            max-width: 440px;
            margin: 0 auto 20px auto;
            gap: 10px;
        }

        .quiz-field {
            flex: 1;
            padding: 14px;
            background: #151221;
            border: 1px solid var(--border);
            color: #fff;
            font-size: 20px;
            font-family: 'Roboto Mono', monospace;
            border-radius: 8px;
            text-transform: uppercase;
            text-align: center;
            outline: none;
        }

        .quiz-field:focus {
            border-color: var(--accent-dark);
        }

        .quiz-submit {
            padding: 14px 28px;
            background: var(--accent-dark);
            border: none;
            color: var(--text-light);
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
        }

        .quiz-controls {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-top: 16px;
            align-items: center;
        }

        .restart-btn {
            background: transparent;
            border: 1px solid var(--incorrect);
            color: var(--incorrect);
            padding: 8px 16px;
            border-radius: 6px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .restart-btn:hover {
            background: rgba(255, 138, 128, 0.1);
        }

        .feedback-banner {
            padding: 14px;
            border-radius: 8px;
            margin-top: 16px;
            font-weight: bold;
            display: none;
            text-align: left;
        }

        .feedback-banner.success {
            display: block;
            background: rgba(129, 199, 132, 0.08);
            color: var(--correct);
            border-left: 4px solid var(--correct);
        }

        .feedback-banner.error {
            display: block;
            background: rgba(255, 138, 128, 0.08);
            color: var(--incorrect);
            border-left: 4px solid var(--incorrect);
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            backdrop-filter: blur(4px);
        }

        .modal-content {
            background: var(--bg-surface);
            border: 2px solid var(--border);
            border-radius: 16px;
            max-width: 600px;
            width: 100%;
            padding: 28px;
            max-height: 85vh;
            overflow-y: auto;
        }

        .modal-content h2 {
            font-family: 'Montserrat', sans-serif;
            color: var(--accent-dark);
            margin-bottom: 16px;
            font-size: 24px;
        }

        .modal-content li {
            margin-left: 20px;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .close-modal-btn {
            background: var(--accent-dark);
            color: var(--text-light);
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            margin-top: 20px;
            cursor: pointer;
            float: right;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Number System Hub</h1>
        <p>Interactive 64-Bit Textbook Conceptual Architecture Suite</p>
        <button class="manual-trigger-btn" onclick="openManual()">User Manual</button>
    </header>

    <div class="tabs">
        <button id="btn-tab-calc" class="tab-btn active" onclick="switchTab('calc')">Interactive Converter Platform</button>
        <button id="btn-tab-quiz" class="tab-btn" onclick="switchTab('quiz')">Self-Assessment Challenge Lab</button>
    </div>

    <!-- CALC SHEET INTERFACE -->
    <div id="calc-tab" class="tab-content active">
        <div class="calc-layout">
            <div>
                <div class="base-selector">
                    <div class="base-radio">
                        <input type="radio" id="src-bin" name="src-base" value="2" onchange="changeActiveBase('BIN', 2)">
                        <label for="src-bin">BIN (Base 2)</label>
                    </div>
                    <div class="base-radio">
                        <input type="radio" id="src-oct" name="src-base" value="8" onchange="changeActiveBase('OCT', 8)">
                        <label for="src-oct">OCT (Base 8)</label>
                    </div>
                    <div class="base-radio">
                        <input type="radio" id="src-dec" name="src-base" value="10" checked onchange="changeActiveBase('DEC', 10)">
                        <label for="src-dec">DEC (Base 10)</label>
                    </div>
                    <div class="base-radio">
                        <input type="radio" id="src-hex" name="src-base" value="16" onchange="changeActiveBase('HEX', 16)">
                        <label for="src-hex">HEX (Base 16)</label>
                    </div>
                </div>

                <div class="display-panel">
                    <div class="base-row" id="row-BIN"><span class="base-label">BIN</span><div class="value-wrapper"><span class="base-value" id="val-BIN">0</span><button class="copy-btn" onclick="copyValue('val-BIN')">Copy</button></div></div>
                    <div class="base-row" id="row-OCT"><span class="base-label">OCT</span><div class="value-wrapper"><span class="base-value" id="val-OCT">0</span><button class="copy-btn" onclick="copyValue('val-OCT')">Copy</button></div></div>
                    <div class="base-row" id="row-DEC"><span class="base-label">DEC</span><div class="value-wrapper"><span class="base-value" id="val-DEC">0</span><button class="copy-btn" onclick="copyValue('val-DEC')">Copy</button></div></div>
                    <div class="base-row" id="row-HEX"><span class="base-label">HEX</span><div class="value-wrapper"><span class="base-value" id="val-HEX">0</span><button class="copy-btn" onclick="copyValue('val-HEX')">Copy</button></div></div>
                </div>
                <div class="keypad">
                    <button class="key action-key" onclick="pressKey('D')">D</button>
                    <button class="key action-key" onclick="pressKey('E')">E</button>
                    <button class="key action-key" onclick="pressKey('F')">F</button>
                    <button class="key clear-key" onclick="clearCalculator()">AC</button>
                    <button class="key action-key" onclick="pressKey('A')">A</button>
                    <button class="key action-key" onclick="pressKey('B')">B</button>
                    <button class="key action-key" onclick="pressKey('C')">C</button>
                    <button class="key" onclick="pressKey('9')">9</button>
                    <button class="key" onclick="pressKey('8')">8</button>
                    <button class="key" onclick="pressKey('7')">7</button>
                    <button class="key" onclick="pressKey('6')">6</button>
                    <button class="key" onclick="pressKey('5')">5</button>
                    <button class="key" onclick="pressKey('4')">4</button>
                    <button class="key" onclick="pressKey('3')">3</button>
                    <button class="key" onclick="pressKey('2')">2</button>
                    <button class="key" onclick="pressKey('1')">1</button>
                    <button class="key" style="grid-column: span 4;" onclick="pressKey('0')">0</button>
                </div>
            </div>
        </div>

        <div class="explanation-trigger-pane">
            <button class="popup-toggle-btn" id="drawer-toggle-btn" onclick="toggleExplanationDrawer()">Click to Reveal Step-by-Step Explanations Underneath</button>
        </div>

        <!-- COLLAPSIBLE EDUCATIONAL CONTAINER -->
        <div class="steps-drawer-modal" id="explanation-drawer">
            <h3>Deep Conceptual Breakdown Pipeline</h3>
            <div id="steps-output">Enter numbers above to compile visual explanation charts.</div>
        </div>

        <div class="table-scroll-wrapper" style="margin-top: 24px; padding: 20px;">
            <h3 style="font-family:'Montserrat',sans-serif; color:var(--accent-dark); margin-bottom:10px; font-size:16px;">Quick Conversion Matrix Summary (0 - 15)</h3>
            <table class="step-table">
                <thead>
                    <tr>
                        <th>Decimal (DEC)</th>
                        <th>Binary (BIN)</th>
                        <th>Octal (OCT)</th>
                        <th>Hexadecimal (HEX)</th>
                    </tr>
                </thead>
                <tbody id="summary-table-body"></tbody>
            </table>
        </div>
    </div>

    <!-- QUIZ PRACTICE MODULE -->
    <div id="quiz-tab" class="tab-content">
        <div class="quiz-card">
            <div class="quiz-question" id="quiz-prompt">Generating math problem parameters...</div>
            <div class="quiz-input-group">
                <input type="text" id="quiz-answer" class="quiz-field" placeholder="Answer string..." autocomplete="off">
                <button class="quiz-submit" onclick="submitQuizAnswer()">Submit Answer</button>
            </div>
            <div id="quiz-feedback" class="feedback-banner"></div>
            
            <div class="quiz-controls">
                <div id="quiz-score" style="font-family:'Montserrat',sans-serif; font-weight:600; font-size:15px; color:var(--accent-dark);">Success Register: 0 / 0 (0%)</div>
                <button class="restart-btn" onclick="resetQuizLogMetrics()">Reset Progress</button>
            </div>
            
            <div class="table-scroll-wrapper" id="quiz-explanation-wrapper" style="display:none; padding:16px;">
                <div id="quiz-explanation-box"></div>
            </div>
        </div>
    </div>
</div>

<div id="manual-modal" class="modal-overlay" onclick="closeManualOnOverlay(event)">
    <div class="modal-content">
        <h2>System Operator Manual</h2>
        <p style="margin-bottom: 12px; font-size: 14px; color: var(--text-muted);">Welcome to the textbook-grade 64-bit multi-base number execution layout workspace.</p>
        <ul>
            <li>64-Bit Range Scale Architecture: Handles massive integer strings cleanly up to 2<sup>64</sup>-1 using modern precision BigInt processing algorithms.</li>
            <li>No Flow-off Layout Wrap: Complete word-wrapping safeguards prevent high numeric values from flying off your viewport box bounds.</li>
            <li>Reactive Safeguard Keypad: Instantly locks layout choices to completely block syntax mistakes before they can occur.</li>
        </ul>
        <button class="close-modal-btn" onclick="closeManual()">Close Manual Workspace</button>
    </div>
</div>
<script>
    let activeBaseName = 'DEC';
    let activeRadix = 10;
    let internalDecimalValue = 0n; 
    const MAX_64_BIT = (1n << 64n) - 1n; 
    let explanationDrawerOpen = false;

    let quizCorrect = 0;
    let quizTotal = 0;
    let activeQuizAnswerKey = "";
    let activeQuizDecimalValue = 0n;
    let activeQuizTargetRadix = 10;

    window.onload = function() {
        updateKeypadMasking();
        generateQuizQuestion();
        buildSummaryConversionMatrix();
    };

    function switchTab(tabId) {
        document.getElementById('calc-tab').classList.remove('active');
        document.getElementById('quiz-tab').classList.remove('active');
        document.getElementById('btn-tab-calc').classList.remove('active');
        document.getElementById('btn-tab-quiz').classList.remove('active');
        
        if(tabId === 'calc') {
            document.getElementById('calc-tab').classList.add('active');
            document.getElementById('btn-tab-calc').classList.add('active');
        } else {
            document.getElementById('quiz-tab').classList.add('active');
            document.getElementById('btn-tab-quiz').classList.add('active');
        }
    }

    function toggleExplanationDrawer() {
        const drawer = document.getElementById('explanation-drawer');
        const btn = document.getElementById('drawer-toggle-btn');
        explanationDrawerOpen = !explanationDrawerOpen;
        
        if (explanationDrawerOpen) {
            drawer.style.display = 'block';
            btn.textContent = "Click to Collapse Mathematical Explanations Pane";
            generateMathematicalExplanations();
        } else {
            drawer.style.display = 'none';
            btn.textContent = "Click to Reveal Step-by-Step Explanations Underneath";
        }
    }

    function openManual() { document.getElementById('manual-modal').style.display = 'flex'; }
    function closeManual() { document.getElementById('manual-modal').style.display = 'none'; }
    function closeManualOnOverlay(e) { if(e.target.id === 'manual-modal') closeManual(); }

    function copyValue(elementId) {
        const text = document.getElementById(elementId).textContent;
        navigator.clipboard.writeText(text).then(() => {
            alert("Copied directly to clipboard: " + text);
        });
    }

    function parseBigInt(str, radix) {
        let val = 0n;
        let chars = "0123456789ABCDEF";
        for (let i = 0; i < str.length; i++) {
            let index = chars.indexOf(str[i].toUpperCase());
            if (index === -1 || index >= radix) continue;
            val = val * BigInt(radix) + BigInt(index);
        }
        return val;
    }
    function updateKeypadMasking() {
        document.querySelectorAll('.base-row').forEach(row => row.classList.remove('selected'));
        document.getElementById(`row-${activeBaseName}`).classList.add('selected');

        document.querySelectorAll('.key').forEach(keyButton => {
            const val = keyButton.textContent;
            if (val === 'AC') return;
            
            let isAllowed = false;
            if (activeBaseName === 'BIN') isAllowed = (val === '0' || val === '1');
            else if (activeBaseName === 'OCT') isAllowed = (val >= '0' && val <= '7');
            else if (activeBaseName === 'DEC') isAllowed = (val >= '0' && val <= '9');
            else if (activeBaseName === 'HEX') isAllowed = true;

            keyButton.disabled = !isAllowed;
            if (isAllowed) keyButton.classList.remove('grayed-out');
            else keyButton.classList.add('grayed-out');
        });
    }

    function changeActiveBase(baseName, radix) {
        activeBaseName = baseName;
        activeRadix = radix;
        updateKeypadMasking();
        updateDisplayValues();
        if (explanationDrawerOpen) generateMathematicalExplanations();
    }

    function pressKey(char) {
        let currentStringValue = document.getElementById(`val-${activeBaseName}`).textContent;
        if (currentStringValue === '0') currentStringValue = '';
        
        let testString = currentStringValue + char;
        let parsedValue = parseBigInt(testString, activeRadix);
        
        if (parsedValue > MAX_64_BIT) {
            alert("Specification Sizing Halt: Target buffer value overruns unsigned 64-bit space limits.");
            return;
        }

        internalDecimalValue = parsedValue;
        updateDisplayValues();
        if (explanationDrawerOpen) generateMathematicalExplanations();
    }

    function clearCalculator() {
        internalDecimalValue = 0n;
        updateDisplayValues();
        if (explanationDrawerOpen) generateMathematicalExplanations();
    }

    function updateDisplayValues() {
        document.getElementById('val-BIN').textContent = internalDecimalValue.toString(2).toUpperCase();
        document.getElementById('val-OCT').textContent = internalDecimalValue.toString(8).toUpperCase();
        document.getElementById('val-DEC').textContent = internalDecimalValue.toString(10).toUpperCase();
        document.getElementById('val-HEX').textContent = internalDecimalValue.toString(16).toUpperCase();
    }

    function generateMathematicalExplanations() {
        const outputBox = document.getElementById('steps-output');
        if (internalDecimalValue === 0n) {
            outputBox.innerHTML = "Value register evaluates to baseline zero across all conversions.";
            return;
        }

        let html = `<p style='margin-bottom:20px; font-family:"Montserrat",sans-serif; font-weight:600; font-size:15px; color:var(--accent-dark); border-bottom:1px dashed var(--border); padding-bottom:8px;'>Analyzing Calculations for Decimal Size: <span style="word-break:break-all;">${internalDecimalValue.toString(10)}</span></p>`;

        // BLOCK 1: TARGETING BINARY WITH HORIZONTAL SCROLL SAFEGUARDS
        html += `<div class='conversion-block'><h4>Converting to BINARY (Base 2)</h4>`;
        html += `<p>Computers split values into baskets of powers of 2. If the basket weight fits inside our remaining value, we activate it with a 1, otherwise we write a 0. Here are the low-order byte columns:</p>`;
        html += `<div class='table-scroll-wrapper'><div class='visual-box-container'>`;
        let binStr = internalDecimalValue.toString(2);
        let paddingLength = binStr.length < 8 ? 8 : Math.ceil(binStr.length / 8) * 8;
        if (paddingLength > 64) paddingLength = 64;
        let completeBinStr = binStr.padStart(paddingLength, '0');
        
        let displayBitsCount = Math.min(completeBinStr.length, 16);
        for(let i = completeBinStr.length - displayBitsCount; i < completeBinStr.length; i++) {
            let bitPos = completeBinStr.length - 1 - i;
            let weightVal = 1n << BigInt(bitPos);
            let isActive = completeBinStr[i] === '1';
            let labelStr = weightVal.toString(10);
            if (labelStr.length > 5) labelStr = "2<sup>" + bitPos + "</sup>";
            html += `<div class='visual-box ${isActive?'active':''}'>${labelStr}<br><small>bit:${completeBinStr[i]}</small></div>`;
        }
        html += `</div></div><p style='font-size:14px; margin-top:8px; color:var(--text-muted);'>Full continuous code token string: <span style='font-family:"Roboto Mono", monospace; color:var(--accent-dark); word-break: break-all;'>${completeBinStr}</span></p></div>`;

        // BLOCK 2: TARGETING DECIMAL WITH SCROLL SAFETY WRAPPERS
        html += `<div class='conversion-block'><h4>Converting to DECIMAL (Base 10)</h4>`;
        html += `<p>We take each digit symbol from our current number string and multiply it by its place-value column weight:</p>`;
        html += `<div class='table-scroll-wrapper'><table class='step-table'><tr><th>Source Character</th>`;
        let srcRepresentationStr = internalDecimalValue.toString(activeRadix).toUpperCase();
        for(let i=0; i<srcRepresentationStr.length; i++) html += `<td><b>${srcRepresentationStr[i]}</b></td>`;
        html += `</tr><tr><th>Radix Multiplier</th>`;
        for(let i=srcRepresentationStr.length-1; i>=0; i--) html += `<td>${activeRadix}<sup>${i}</sup></td>`;
        html += `</tr></table></div><p style='margin-top:12px; font-size:14px;'>Adding these positional products together builds our standard human base-10 value: <span style="word-break:break-all;"><b>${internalDecimalValue.toString(10)}</b></span></p></div>`;
        // BLOCK 3: TARGETING OCTAL CONVERSION
        html += `<div class='conversion-block'><h4>Converting to OCTAL (Base 8)</h4>`;
        html += `<p>We repeatedly divide our decimal payload number by 8. We save the remainder from each step, then read them from the bottom row up to get our answer:</p>`;
        html += `<div class='table-scroll-wrapper'><table class='step-table'><tr><th>Division Formula</th><th>Whole Quotient</th><th>Leftover Remainder</th></tr>`;
        let oTemp = internalDecimalValue;
        while(oTemp > 0n) {
            html += `<tr><td>${oTemp.toString(10)} ÷ 8</td><td>${(oTemp / 8n).toString(10)}</td><td><b>${(oTemp % 8n).toString(10)}</b></td></tr>`;
            oTemp = oTemp / 8n;
        }
        html += `</table></div><p style='margin-top:12px; font-size:14px;'>Resulting base-8 string value: <span style='color:var(--accent-dark); font-weight:bold; word-break:break-all;'>${internalDecimalValue.toString(8)}</span></p></div>`;

        // BLOCK 4: TARGETING HEXADECIMAL CONVERSION
        html += `<div class='conversion-block'><h4>Converting to HEXADECIMAL (Base 16)</h4>`;
        html += `<p>We repeatedly divide our decimal number by 16. If any remainder is 10 or bigger, we swap it for a standard textbook letter label (A=10, B=11...):</p>`;
        html += `<div class='table-scroll-wrapper'><table class='step-table'><tr><th>Division Formula</th><th>Whole Quotient</th><th>Leftover Remainder</th></tr>`;
        let hTemp = internalDecimalValue;
        while(hTemp > 0n) {
            let rem = hTemp % 16n;
            let rStr = rem >= 10n ? String.fromCharCode(55 + Number(rem)) + ` (${rem.toString(10)})` : rem.toString(10);
            html += `<tr><td>${hTemp.toString(10)} ÷ 16</td><td>${(hTemp / 16n).toString(10)}</td><td><b>${rStr}</b></td></tr>`;
            hTemp = hTemp / 16n;
        }
        html += `</table></div><p style='margin-top:12px; font-size:14px;'>Resulting base-16 string value: <span style='color:var(--accent-dark); font-weight:bold; word-break:break-all;'>${internalDecimalValue.toString(16).toUpperCase()}</span></p></div>`;

        outputBox.innerHTML = html;
    }

    function buildSummaryConversionMatrix() {
        const tbody = document.getElementById('summary-table-body');
        let html = "";
        for (let i = 0; i <= 15; i++) {
            html += `<tr>
                <td><b>${i}</b></td>
                <td>${i.toString(2).padStart(4, '0')}</td>
                <td>${i.toString(8)}</td>
                <td><b>${i.toString(16).toUpperCase()}</b></td>
            </tr>`;
        }
        tbody.innerHTML = html;
    }

    function generateQuizQuestion() {
        const bases = [
            { name: "Binary", radix: 2 },
            { name: "Octal", radix: 8 },
            { name: "Decimal", radix: 10 },
            { name: "Hexadecimal", radix: 16 }
        ];
        let srcIdx = Math.floor(Math.random() * 4);
        let tgtIdx;
        do { tgtIdx = Math.floor(Math.random() * 4); } while (tgtIdx === srcIdx);

        let randVal = Math.floor(Math.random() * 254) + 1;
        activeQuizDecimalValue = BigInt(randVal);
        activeQuizTargetRadix = bases[tgtIdx].radix;
        activeQuizAnswerKey = activeQuizDecimalValue.toString(activeQuizTargetRadix).toUpperCase();

        document.getElementById('quiz-prompt').innerHTML = 
            `Convert the source <b>${bases[srcIdx].name}</b> value: <span style='color:var(--accent-dark); font-family:"Roboto Mono",monospace; font-size:22px; display:block; margin:6px 0;'>${activeQuizDecimalValue.toString(bases[srcIdx].radix).toUpperCase()}</span> into its equivalent target <b>${bases[tgtIdx].name}</b> string parameter:`;
        
        document.getElementById('quiz-answer').value = "";
        document.getElementById('quiz-feedback').style.display = "none";
        document.getElementById('quiz-explanation-wrapper').style.display = "none";
    }

    function submitQuizAnswer() {
        const input = document.getElementById('quiz-answer').value.trim().toUpperCase();
        const banner = document.getElementById('quiz-feedback');
        if(!input) return;

        quizTotal++;
        if(input === activeQuizAnswerKey) {
            quizCorrect++;
            banner.className = "feedback-banner success";
            banner.textContent = "Evaluation Success! Your calculation logs match system expectations perfectly.";
            banner.style.display = "block";
            setTimeout(generateQuizQuestion, 2000);
        } else {
            banner.className = "feedback-banner error";
            banner.textContent = `Incorrect result string. The expected evaluation key was: ${activeQuizAnswerKey}`;
            banner.style.display = "block";
            renderQuizExplanation();
        }
        let pct = quizTotal > 0 ? Math.round((quizCorrect / quizTotal) * 100) : 0;
        document.getElementById('quiz-score').textContent = `Success Register: ${quizCorrect} / ${quizTotal} (${pct}%)`;
    }

    function resetQuizLogMetrics() {
        quizCorrect = 0;
        quizTotal = 0;
        document.getElementById('quiz-score').textContent = "Success Register: 0 / 0 (0%)";
        generateQuizQuestion();
    }

    function renderQuizExplanation() {
        const wrapper = document.getElementById('quiz-explanation-wrapper');
        const box = document.getElementById('quiz-explanation-box');
        wrapper.style.display = "block";
        let html = "<h4>🎓 Step-by-Step Problem Resolution Table:</h4>";
        html += "<p>This problem translates to decimal value size: <b>" + activeQuizDecimalValue.toString(10) + "</b>.</p><table class='step-table'>";
        let calcVal = activeQuizDecimalValue;
        while(calcVal > 0n) {
            html += "<tr><td>" + calcVal.toString(10) + " ÷ " + activeQuizTargetRadix + "</td><td>Station Remainder Leftover Digit: <b>" + (calcVal % BigInt(activeQuizTargetRadix)).toString(activeQuizTargetRadix).toUpperCase() + "</b></td></tr>";
            calcVal = calcVal / BigInt(activeQuizTargetRadix);
        }
        html += "</table><button class='quiz-submit' style='margin-top:12px; width:100%;' onclick='generateQuizQuestion()'>Load Next Lab Exercise</button>";
        box.innerHTML = html;
    }
</script>
