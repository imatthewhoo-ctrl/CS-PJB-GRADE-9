<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Number System Hub</title>
    <style>
        :root {
            /* Your custom-selected neon cosmic color palette tokens */
            --bg-primary: #130F26;       /* Deep Midnight Purple canvas */
            --bg-surface: #1E1B4B;       /* Dark Indigo / Navy card panel surface */
            --text-main: #F3F4F6;        /* Cool Off-White primary text reading layer */
            --accent-purple: #8B5CF6;    /* Vibrant Violet secondary accent branding */
            --accent-blue: #38BDF8;      /* Bright Electric Sky Blue primary highlight focal track */
            --cta-pink: #F43F5E;         /* Neon Pink call-to-action popping banner highlight */
            --gray-disabled: #181635;    /* Frosted midnight key lock mask for unusable buttons */
            --border: #2E2963;           /* Subdued cosmic hairline partition lines */
            --correct: #34D399;          /* Emerald success validation node */
            --incorrect: #F87171;        /* Pastel crimson validation error flag */
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            padding: 20px;
        }
        .container {
            width: 100%;
            max-width: 1100px;
            background-color: var(--bg-surface);
            border-radius: 16px;
            padding: 24px;
            margin: 20px auto;
            box-shadow: 0 12px 40px rgba(10, 8, 25, 0.6);
            border: 1px solid var(--border);
        }

        header {
            text-align: center;
            margin-bottom: 24px;
            border-bottom: 2px solid var(--accent-blue);
            padding-bottom: 16px;
            position: relative;
        }

        header h1 {
            color: var(--accent-blue);
            font-size: 28px;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
            text-shadow: 0 0 15px rgba(56, 189, 248, 0.2);
        }

        header p {
            color: var(--text-main);
            opacity: 0.8;
            font-size: 14px;
        }

        .manual-trigger-btn {
            position: absolute;
            right: 10px;
            top: 10px;
            background-color: var(--accent-blue);
            color: var(--bg-primary);
            border: none;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
            box-shadow: 0 4px 12px rgba(56, 189, 248, 0.3);
            transition: all 0.2s ease;
        }

        .manual-trigger-btn:hover {
            background-color: var(--accent-purple);
            color: var(--text-main);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(139, 92, 246, 0.4);
        }

        .tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 20px;
        }
        .tab-btn {
            flex: 1;
            padding: 12px;
            background: #161338;
            border: 1px solid var(--border);
            color: var(--text-main);
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .tab-btn.active {
            background: var(--accent-blue);
            color: var(--bg-primary);
            border-color: var(--accent-blue);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .calc-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }

        @media (min-width: 850px) {
            .calc-layout {
                grid-template-columns: 1.2fr 1fr;
            }
        }

        .display-panel {
            background: var(--bg-primary);
            padding: 16px;
            border-radius: 12px;
            margin-bottom: 16px;
            border: 2px solid var(--accent-blue);
        }

        .base-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
            border-bottom: 1px solid var(--border);
            gap: 12px;
        }

        .base-row:last-child {
            border-bottom: none;
        }

        .base-label {
            font-weight: bold;
            font-size: 14px;
            color: var(--accent-blue);
            width: 50px;
            flex-shrink: 0;
            letter-spacing: 0.5px;
        }
        .value-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-grow: 1;
            justify-content: flex-end;
            min-width: 0;
        }

        .base-value {
            font-size: 20px;
            font-family: 'Consolas', 'Courier New', monospace;
            font-weight: bold;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: var(--text-main);
        }

        .copy-btn {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            color: var(--accent-blue);
            padding: 4px 10px;
            font-size: 12px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }

        .copy-btn:hover {
            background: var(--accent-purple);
            color: var(--text-main);
            border-color: var(--accent-purple);
        }

        .base-row.selected {
            background: rgba(56, 189, 248, 0.08);
            border-radius: 6px;
        }

        .base-selector {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
        }

        .base-radio {
            flex: 1;
            text-align: center;
        }

        .base-radio input {
            display: none;
        }

        .base-radio label {
            display: block;
            padding: 12px 6px;
            background: #161338;
            border: 1px solid var(--border);
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            font-size: 13px;
            transition: all 0.2s;
        }

        .base-radio input:checked + label {
            background: var(--accent-blue);
            color: var(--bg-primary);
            border-color: var(--accent-blue);
        }

        .keypad {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }

        .key {
            padding: 16px;
            background: #161338;
            border: 1px solid var(--border);
            color: var(--text-main);
            font-size: 18px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.1s;
        }

        .key.action-key {
            background: var(--accent-purple);
            color: var(--text-main);
            border-color: var(--accent-purple);
        }

        .key.clear-key {
            background: rgba(244, 63, 94, 0.15);
            color: var(--cta-pink);
            border-color: rgba(244, 63, 94, 0.3);
        }

        .key:disabled, .key.grayed-out {
            background: var(--gray-disabled) !important;
            color: #383561 !important;
            border-color: #120F2B !important;
            opacity: 0.2;
            cursor: not-allowed;
            pointer-events: none;
        }

        .steps-panel {
            background: var(--bg-primary);
            padding: 18px;
            border-radius: 12px;
            border: 2px solid var(--accent-blue);
            max-height: 520px;
            overflow-y: auto;
        }

        .step-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            font-size: 13px;
            background: var(--bg-surface);
        }

        .step-table th, .step-table td {
            border: 1px solid var(--border);
            padding: 8px;
            text-align: left;
        }

        .step-table th {
            background: var(--accent-purple);
            color: var(--text-main);
        }

        .interactive-explanation {
            background: rgba(139, 92, 246, 0.04);
            border: 1px dashed var(--accent-purple);
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 14px;
            font-size: 13px;
            line-height: 1.5;
        }

        .interactive-explanation h4 {
            color: var(--accent-blue);
            margin-bottom: 4px;
        }

        .summary-table-section {
            margin-top: 24px;
            background: var(--bg-primary);
            padding: 16px;
            border-radius: 12px;
            border: 2px solid var(--accent-blue);
        }

        .summary-table-section h3 {
            margin-bottom: 10px;
            font-size: 16px;
            color: var(--accent-blue);
        }

        .quiz-card {
            background: var(--bg-primary);
            padding: 24px;
            border-radius: 12px;
            border: 2px solid var(--accent-blue);
            text-align: center;
        }

        .quiz-question {
            font-size: 18px;
            margin-bottom: 16px;
        }

        .quiz-input-group {
            display: flex;
            max-width: 400px;
            margin: 0 auto 16px auto;
            gap: 8px;
        }

        .quiz-field {
            flex: 1;
            padding: 12px;
            background: #161338;
            border: 1px solid var(--border);
            color: var(--text-main);
            font-size: 18px;
            border-radius: 6px;
            text-transform: uppercase;
            font-weight: bold;
            text-align: center;
        }

        .quiz-submit {
            padding: 12px 24px;
            background: var(--accent-blue);
            border: none;
            color: var(--bg-primary);
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.75);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 15px;
            backdrop-filter: blur(5px);
        }

        .modal-content {
            background: var(--bg-surface);
            border: 3px solid var(--accent-blue);
            border-radius: 12px;
            max-width: 650px;
            width: 100%;
            padding: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.6);
            position: relative;
            max-height: 85vh;
            overflow-y: auto;
        }

        .modal-content h2 {
            color: var(--accent-blue);
            margin-bottom: 12px;
            border-bottom: 2px solid var(--accent-purple);
            padding-bottom: 6px;
            font-size: 22px;
        }

        .modal-content h3 {
            margin: 14px 0 6px 0;
            font-size: 15px;
            color: var(--accent-blue);
        }

        .modal-content p, .modal-content li {
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 8px;
            color: var(--text-main);
        }

        .modal-content ul {
            margin-left: 20px;
        }

        .close-modal-btn {
            background-color: var(--accent-blue);
            color: var(--bg-primary);
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            float: right;
            margin-top: 15px;
        }

        .close-modal-btn:hover {
            background-color: var(--accent-purple);
            color: var(--text-main);
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Number System Hub</h1>
        <p>Grade 9 Interactive Number Systems Practice Suite</p>
        <button class="manual-trigger-btn" onclick="openManual()">📖 Help / Manual</button>
    </header>

    <div class="tabs">
        <button id="btn-tab-calc" class="tab-btn active" onclick="switchTab('calc')">Interactive Conversions</button>
        <button id="btn-tab-quiz" class="tab-btn" onclick="switchTab('quiz')">Quiz Self-Test Mode</button>
    </div>

    <!-- CALCULATOR INTERFACE TAB -->
    <div id="calc-tab" class="tab-content active">
        <div class="calc-layout">
            <div>
                <div class="base-selector">
                    <div class="base-radio">
                        <input type="radio" id="src-bin" name="src-base" value="2" onchange="changeActiveBase('BIN', 2)">
                        <label for="src-bin">BIN (Base 2)</label>
                    </div>
                    <div class="base-radio">
                        <input type="radio" id="src-oct" name="src-base" value="8" onchange="changeActiveBase('OCT', 8)">
                        <label for="src-oct">OCT (Base 8)</label>
                    </div>
                    <div class="base-radio">
                        <input type="radio" id="src-dec" name="src-base" value="10" checked onchange="changeActiveBase('DEC', 10)">
                        <label for="src-dec">DEC (Base 10)</label>
                    </div>
                    <div class="base-radio">
                        <input type="radio" id="src-hex" name="src-base" value="16" onchange="changeActiveBase('HEX', 16)">
                        <label for="src-hex">HEX (Base 16)</label>
                    </div>
                </div>

                <div class="display-panel">
                    <div class="base-row" id="row-BIN">
                        <span class="base-label">BIN</span>
                        <div class="value-wrapper">
                            <span class="base-value" id="val-BIN">0</span>
                            <button class="copy-btn" onclick="copyValue('val-BIN')">Copy</button>
                        </div>
                    </div>
                    <div class="base-row" id="row-OCT">
                        <span class="base-label">OCT</span>
                        <div class="value-wrapper">
                            <span class="base-value" id="val-OCT">0</span>
                            <button class="copy-btn" onclick="copyValue('val-OCT')">Copy</button>
                        </div>
                    </div>
                    <div class="base-row" id="row-DEC">
                        <span class="base-label">DEC</span>
                        <div class="value-wrapper">
                            <span class="base-value" id="val-DEC">0</span>
                            <button class="copy-btn" onclick="copyValue('val-DEC')">Copy</button>
                        </div>
                    </div>
                    <div class="base-row" id="row-HEX">
                        <span class="base-label">HEX</span>
                        <div class="value-wrapper">
                            <span class="base-value" id="val-HEX">0</span>
                            <button class="copy-btn" onclick="copyValue('val-HEX')">Copy</button>
                        </div>
                    </div>
                </div>

                <div class="keypad">
                    <button class="key action-key" onclick="pressKey('D')">D</button>
                    <button class="key action-key" onclick="pressKey('E')">E</button>
                    <button class="key action-key" onclick="pressKey('F')">F</button>
                    <button class="key clear-key" onclick="clearCalculator()">AC</button>
                    <button class="key action-key" onclick="pressKey('A')">A</button>
                    <button class="key action-key" onclick="pressKey('B')">B</button>
                    <button class="key action-key" onclick="pressKey('C')">C</button>
                    <button class="key" onclick="pressKey('9')">9</button>
                    <button class="key" onclick="pressKey('8')">8</button>
                    <button class="key" onclick="pressKey('7')">7</button>
                    <button class="key" onclick="pressKey('6')">6</button>
                    <button class="key" onclick="pressKey('5')">5</button>
                    <button class="key" onclick="pressKey('4')">4</button>
                    <button class="key" onclick="pressKey('3')">3</button>
                    <button class="key" onclick="pressKey('2')">2</button>
                    <button class="key" onclick="pressKey('1')">1</button>
                    <button class="key" style="grid-column: span 4;" onclick="pressKey('0')">0</button>
                </div>
            </div>
            <div>
                <div class="steps-panel" style="margin-bottom: 16px;">
                    <div id="base-explanation-box" class="interactive-explanation"></div>
                </div>
                <div class="steps-panel">
                    <h3 style="color:var(--accent-blue); margin-bottom:6px; border-bottom:1px solid var(--border); padding-bottom:4px;">How It's Calculated:</h3>
                    <div id="steps-output">Enter numbers to generate structural step explanations.</div>
                </div>
            </div>
        </div>

        <div class="summary-table-section">
            <h3>📊 Quick Conversion Matrix Summary (0 - 15)</h3>
            <p style="font-size: 13px; margin-bottom: 10px; color: var(--accent-purple);">Here is how the first 16 values align across all four base formats. Observe the structural patterns!</p>
            <table class="step-table" style="margin-top: 0;">
                <thead>
                    <tr>
                        <th>Decimal (DEC)</th>
                        <th>Binary (BIN)</th>
                        <th>Octal (OCT)</th>
                        <th>Hexadecimal (HEX)</th>
                    </tr>
                </thead>
                <tbody id="summary-table-body"></tbody>
            </table>
        </div>
    </div>

    <!-- QUIZ INTERFACE TAB -->
    <div id="quiz-tab" class="tab-content">
        <div class="quiz-card">
            <div class="quiz-question" id="quiz-prompt">Generating question framework...</div>
            <div class="quiz-input-group">
                <input type="text" id="quiz-answer" class="quiz-field" placeholder="Type your answer...">
                <button class="quiz-submit" onclick="submitQuizAnswer()">Submit</button>
            </div>
            <div id="quiz-feedback" class="feedback-banner"></div>
            <div id="quiz-score" class="score-counter">Score: 0 / 0</div>
            <div id="quiz-explanation-box" class="steps-panel" style="margin-top: 20px; display: none; text-align: left;"></div>
        </div>
    </div>
</div>

<!-- HELP POPUP MODAL MANUAL -->
<div id="manual-modal" class="modal-overlay" onclick="closeManualOnOverlay(event)">
    <div class="modal-content">
        <h2>📖 User Manual & Beginners Guide</h2>
        <h3>🌟 Welcome to the Number System Hub!</h3>
        <p>This workspace is designed to help Grade 9 students explore and understand the four major number systems used in computer science lessons.</p>
        <h3>💡 How to Use the Interactive Converter:</h3>
        <ul>
            <li><b>Select an Input Base:</b> Use the top layout radio buttons (BIN, OCT, DEC, HEX) to choose your starting number system format.</li>
            <li><b>Watch the Keypad Adapt:</b> Notice how buttons switch states! If you select <b>BIN (Binary)</b>, buttons 2-9 and A-F turn gray and lock up because binary numbers only use 0s and 1s. This safety rule keeps you from entering invalid digits!</li>
            <li><b>Real-Time Visual Walkthroughs:</b> As you type numbers, notice how the right side panels show place-value columns and radix division charts right away. This teaches you how the conversions work step by step.</li>
            <li><b>One-Click Saving:</b> Click the <b>Copy</b> button next to any value display row to quickly save that conversion directly to your clipboard.</li>
        </ul>
        <h3>📝 How to Use Quiz Practice Mode:</h3>
        <ul>
            <li>Click the <b>Quiz Practice Mode</b> tab at the top to switch panels.</li>
            <li>The engine randomly assigns a conversion question between 0 and 255.</li>
            <li>Type your calculated string in and hit <b>Submit</b>. If you make a mistake, don't worry! The tool will reveal a complete division remediation table showing you how to reach the right result next time.</li>
        </ul>
        <button class="close-modal-btn" onclick="closeManual()">Got it, Close Manual</button>
    </div>
</div>
<script>
    let activeBaseName = 'DEC';
    let activeRadix = 10;
    let internalDecimalValue = 0;

    let quizCorrect = 0;
    let quizTotal = 0;
    let activeQuizAnswerKey = "";
    let activeQuizDecimalValue = 0;
    let activeQuizTargetRadix = 10;

    window.onload = function() {
        updateKeypadMasking();
        generateQuizQuestion();
        buildSummaryConversionMatrix();
        updateBaseContextExplanation();
    };

    function switchTab(tabId) {
        document.getElementById('calc-tab').classList.remove('active');
        document.getElementById('quiz-tab').classList.remove('active');
        document.getElementById('btn-tab-calc').classList.remove('active');
        document.getElementById('btn-tab-quiz').classList.remove('active');
        
        if(tabId === 'calc') {
            document.getElementById('calc-tab').classList.add('active');
            document.getElementById('btn-tab-calc').classList.add('active');
        } else {
            document.getElementById('quiz-tab').classList.add('active');
            document.getElementById('btn-tab-quiz').classList.add('active');
        }
    }

    function openManual() {
        document.getElementById('manual-modal').style.display = 'flex';
    }

    function closeManual() {
        document.getElementById('manual-modal').style.display = 'none';
    }

    function closeManualOnOverlay(e) {
        if(e.target.id === 'manual-modal') closeManual();
    }

    function copyValue(elementId) {
        const textToCopy = document.getElementById(elementId).textContent;
        navigator.clipboard.writeText(textToCopy).then(() => {
            alert("Copied to clipboard: " + textToCopy);
        }).catch(err => {
            console.error("Failed to copy text: ", err);
        });
    }

    function updateKeypadMasking() {
        document.querySelectorAll('.base-row').forEach(row => row.classList.remove('selected'));
        document.getElementById(`row-${activeBaseName}`).classList.add('selected');

        document.querySelectorAll('.key').forEach(keyButton => {
            const val = keyButton.textContent;
            if (val === 'AC') return;
            
            let isAllowed = false;
            if (activeBaseName === 'BIN') isAllowed = (val === '0' || val === '1');
            else if (activeBaseName === 'OCT') isAllowed = (val >= '0' && val <= '7');
            else if (activeBaseName === 'DEC') isAllowed = (val >= '0' && val <= '9');
            else if (activeBaseName === 'HEX') isAllowed = true;

            if (isAllowed) {
                keyButton.disabled = false;
                keyButton.classList.remove('grayed-out');
            } else {
                keyButton.disabled = true;
                keyButton.classList.add('grayed-out');
            }
        });
    }

    function changeActiveBase(baseName, radix) {
        activeBaseName = baseName;
        activeRadix = radix;
        updateKeypadMasking();
        updateDisplayValues();
        generateMathematicalExplanations();
        updateBaseContextExplanation();
    }

    function updateBaseContextExplanation() {
        const box = document.getElementById('base-explanation-box');
        let title = "", details = "";
        
        if (activeBaseName === 'BIN') {
            title = "🚀 Binary System (Base 2)";
            details = "Used inside computer processors. It has only two symbols: <b>0</b> and <b>1</b>. Each column value multiplies by 2 as you move left (1, 2, 4, 8, 16...).";
        } else if (activeBaseName === 'OCT') {
            title = "📦 Octal System (Base 8)";
            details = "Uses eight digits: <b>0 through 7</b>. It groups bits together in chunks of three, acting as an intermediate step between binary and decimal formats.";
        } else if (activeBaseName === 'DEC') {
            title = "🔢 Decimal System (Base 10)";
            details = "The human number system you use every day! Uses 10 symbols: <b>0 through 9</b>. Place values scale upward by powers of ten (1, 10, 100...).";
        } else if (activeBaseName === 'HEX') {
            title = "🎨 Hexadecimal System (Base 16)";
            details = "Saves screen space by condensing binary codes! Since we need 16 symbols, it uses <b>0-9</b> for normal counts and letters <b>A=10, B=11, C=12, D=13, E=14, F=15</b>.";
        }
        
        box.innerHTML = `<h4>${title}</h4><p>${details}</p>`;
    }
</script>
<script>
    function pressKey(char) {
        let currentStringValue = document.getElementById(`val-${activeBaseName}`).textContent;
        if (currentStringValue === '0') currentStringValue = '';
        
        let testString = currentStringValue + char;
        let parsedValue = parseInt(testString, activeRadix);
        
        if (parsedValue > 255) {
            alert("Error: Maximum educational range limit is 255.");
            return;
        }

        internalDecimalValue = parsedValue;
        updateDisplayValues();
        generateMathematicalExplanations();
    }

    function clearCalculator() {
        internalDecimalValue = 0;
        updateDisplayValues();
        document.getElementById('steps-output').innerHTML = "Enter numbers to generate structural step explanations.";
    }

    function updateDisplayValues() {
        document.getElementById('val-BIN').textContent = internalDecimalValue.toString(2).toUpperCase();
        document.getElementById('val-OCT').textContent = internalDecimalValue.toString(8).toUpperCase();
        document.getElementById('val-DEC').textContent = internalDecimalValue.toString(10).toUpperCase();
        document.getElementById('val-HEX').textContent = internalDecimalValue.toString(16).toUpperCase();
    }

    function generateMathematicalExplanations() {
        const outputBox = document.getElementById('steps-output');
        if (internalDecimalValue === 0) {
            outputBox.innerHTML = "Value is 0. Conversions remain baseline zero.";
            return;
        }

        let html = "<p style='margin-bottom:8px;'>Analyzing Decimal Value: <b>" + internalDecimalValue + "</b></p>";
        html += "<strong>1. Binary Place Values Map:</strong><table class='step-table'><tr><th>Bit Column Weight</th><th>128</th><th>64</th><th>32</th><th>16</th><th>8</th><th>4</th><th>2</th><th>1</th></tr><tr><td>Bit Code Status</td>";
        
        let tempVal = internalDecimalValue;
        // Replaced array logic completely to clear the browser compilation bottleneck
        for (let w = 128; w >= 1; w = w / 2) {
            if (tempVal >= w) {
                html += "<td style='color:var(--accent-blue); font-weight:bold; background: rgba(56,189,248,0.15);'>1</td>";
                tempVal -= w;
            } else {
                html += "<td>0</td>";
            }
        }
        html += "</tr></table><br>";

        html += "<strong>2. Successive Remainder Division Loop:</strong><table class='step-table'><tr><th>Target System Base</th><th>Division Expression</th><th>Quotient Out</th><th>Remainder Result</th></tr>";
        
        let octTemp = internalDecimalValue;
        while (octTemp > 0) {
            html += "<tr><td>Octal (Base 8)</td><td>" + octTemp + " ÷ 8</td><td>" + Math.floor(octTemp/8) + "</td><td><b>" + (octTemp % 8) + "</b></td></tr>";
            octTemp = Math.floor(octTemp / 8);
        }

        let hexTemp = internalDecimalValue;
        while (hexTemp > 0) {
            let rem = hexTemp % 16;
            html += "<tr><td>Hexadecimal (Base 16)</td><td>" + hexTemp + " ÷ 16</td><td>" + Math.floor(hexTemp/16) + "</td><td><b>" + rem.toString(16).toUpperCase() + "</b></td></tr>";
            hexTemp = Math.floor(hexTemp / 16);
        }
        
        html += "</table><p style='font-size:11px; color:var(--accent-purple); margin-top:6px;'><i>Tip: Read the remainders from the bottom row up to compile your converted string numbers!</i></p>";
        outputBox.innerHTML = html;
    }

    function buildSummaryConversionMatrix() {
        const tbody = document.getElementById('summary-table-body');
        let html = "";
        for (let i = 0; i <= 15; i++) {
            html += `<tr>
                <td><b>${i}</b></td>
                <td>${i.toString(2).padStart(4, '0')}</td>
                <td>${i.toString(8)}</td>
                <td><b>${i.toString(16).toUpperCase()}</b></td>
            </tr>`;
        }
        tbody.innerHTML = html;
    }

    function generateQuizQuestion() {
        const bases = [
            { name: "Binary", radix: 2 },
            { name: "Octal", radix: 8 },
            { name: "Decimal", radix: 10 },
            { name: "Hexadecimal", radix: 16 }
        ];

        let srcIdx = Math.floor(Math.random() * 4);
        let tgtIdx;
        do { tgtIdx = Math.floor(Math.random() * 4); } while (tgtIdx === srcIdx);

        activeQuizDecimalValue = Math.floor(Math.random() * 254) + 1;
        activeQuizTargetRadix = bases[tgtIdx].radix;
        activeQuizAnswerKey = activeQuizDecimalValue.toString(activeQuizTargetRadix).toUpperCase();

        document.getElementById('quiz-prompt').innerHTML = 
            "Convert the <b>" + bases[srcIdx].name + "</b> value: <span style='color:var(--accent-blue); font-family:monospace; font-size:22px; display:block; margin:8px 0;'>" + activeQuizDecimalValue.toString(bases[srcIdx].radix).toUpperCase() + "</span> into <b>" + bases[tgtIdx].name + "</b>:";
        
        document.getElementById('quiz-answer').value = "";
        document.getElementById('quiz-feedback').style.display = "none";
        document.getElementById('quiz-explanation-box').style.display = "none";
    }

    function submitQuizAnswer() {
        const input = document.getElementById('quiz-answer').value.trim().toUpperCase();
        const banner = document.getElementById('quiz-feedback');
        if(!input) return;

        quizTotal++;
        if(input === activeQuizAnswerKey) {
            quizCorrect++;
            banner.className = "feedback-banner success";
            banner.textContent = "Correct answer! Excellent conversion calculation step coordination.";
            banner.style.display = "block";
            setTimeout(generateQuizQuestion, 2000);
        } else {
            banner.className = "feedback-banner error";
            banner.textContent = "Incorrect notation. The expected target answer string was: " + activeQuizAnswerKey;
            banner.style.display = "block";
            renderQuizExplanation();
        }
        document.getElementById('quiz-score').textContent = "Score: " + quizCorrect + " / " + quizTotal;
    }

    function renderQuizExplanation() {
        const box = document.getElementById('quiz-explanation-box');
        box.style.display = "block";
        let html = "<h4>🎓 Step-by-Step Remediation Breakdown:</h4>";
        html += "<p>This problem uses the baseline decimal value: <b>" + activeQuizDecimalValue + "</b>.</p><table class='step-table'>";
        
        let calcVal = activeQuizDecimalValue;
        while(calcVal > 0) {
            html += "<tr><td>" + calcVal + " ÷ " + activeQuizTargetRadix + "</td><td>Remainder: <b>" + (calcVal % activeQuizTargetRadix).toString(activeQuizTargetRadix).toUpperCase() + "</b></td></tr>";
            calcVal = Math.floor(calcVal / activeQuizTargetRadix);
        }
        html += "</table><button class='quiz-submit' style='margin-top:12px; width:100%;' onclick='generateQuizQuestion()'>Next Challenge</button>";
        box.innerHTML = html;
    }
</script>
